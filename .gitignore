# Scoped to the UFOS build output only — deliberately not the repo-root .gitignore.
# Everything here is generated by the Unity WebGL build; these entries are junk
# that macOS and local tooling drop into the folder and that must never ship.

# macOS Finder metadata, recreated on any folder a Mac has browsed
.DS_Store
**/.DS_Store

# Claude Code machine-local settings
.claude/
