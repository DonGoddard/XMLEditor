<?xml version="1.0" encoding="utf-16"?>
<gorp name="AI Designer">
  <!-- nos-uml-state {"mode":"ai-design","title":"AI Designer","layout":{"ai.sample.CustomerRecords":{"x":6324.32,"y":60,"w":280,"h":150},"ai.sample.TransactionLog":{"x":60,"y":5884.86,"w":280,"h":150},"ai.sample.ChurnPredictor":{"x":29.43,"y":29.43,"w":403.64,"h":150},"ai.sample.ScoreAndRank":{"x":2667.08,"y":60,"w":280,"h":100},"Fight":{"x":292.22,"y":-1.05,"w":280,"h":110},"SkunkModel":{"x":288.02,"y":113.52,"w":280,"h":110},"SkunkData":{"x":532.94,"y":174.49,"w":280,"h":110}}} -->
  <data namespace="SkunkData">
    <variables>
      <variable name="id" type="key" />
      <variable name="value" type="double" />
    </variables>
  </data>
  <model namespace="SkunkModel">
    <variables>
      <variable name="inputs" type="[double]" />
      <variable name="outputs" type="[double]" />
    </variables>
    <operations>
      <operation name="predict" />
    </operations>
  </model>
  <algorithm namespace="ai.sample.CustomerRecords">
    <variables>
      <variable name="id" type="key" />
      <variable name="tenure" type="int" />
      <variable name="monthly" type="double" />
      <variable name="churned" type="bool" />
      <variable name="signedUp" type="utcdatetime" />
    </variables>
  </algorithm>
  <algorithm namespace="ai.sample.TransactionLog">
    <variables>
      <variable name="id" type="guid" />
      <variable name="customer" type="key" />
      <variable name="amounts" type="[double]" />
      <variable name="source" type="uri" />
    </variables>
  </algorithm>
  <algorithm namespace="ai.sample.ChurnPredictor">
    <variables>
      <variable name="features" type="[double]" />
      <variable name="weights" type="[double]" />
      <variable name="bias" type="double = 0.0" />
      <variable name="threshold" type="double = 0.5" />
      <variable name="labels" type="[symbol]" />
    </variables>
    <operations>
      <operation name="predict : double" returns="double">
        <output model="double" />
      </operation>
    </operations>
  </algorithm>
  <algorithm namespace="ai.sample.ScoreAndRank">
    <operations>
      <operation name="score : double" returns="double">
        <output model="double" />
      </operation>
      <operation name="rank : [key]" returns="[key]">
        <output model="[key]" />
      </operation>
      <operation name="explain : string" returns="string">
        <output model="string" />
      </operation>
    </operations>
  </algorithm>
  <algorithm namespace="Fight">
    <operations>
      <operation name="run" />
    </operations>
  </algorithm>
</gorp>