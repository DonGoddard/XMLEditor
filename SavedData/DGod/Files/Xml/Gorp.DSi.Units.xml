<?xml version="1.0" encoding="utf-16"?>
<gorp name="Gorp.DSi.Units">
  <!-- nos-uml-state {"mode":"ai-design","title":"Gorp.DSi.Units","layout":{"SensorFeed":{"x":701.41,"y":60,"w":280,"h":150},"Reading":{"x":352.44,"y":6341.27,"w":280,"h":150},"Verdict":{"x":60,"y":60,"w":280,"h":150},"DwellCheck":{"x":380.71,"y":60,"w":280,"h":100}},"rels":[{"from":"SensorFeed","to":"DwellCheck","type":"Input"},{"from":"DwellCheck","to":"Verdict","type":"Output"}]} -->
  <data namespace="SensorFeed">
    <variables>
      <variable name="elapsed" type="double">
        <unit basis="\second" namespace="D-SI" />
        <comment>Dwell time. PLATINUM: SI base unit.</comment>
      </variable>
      <variable name="payloadMass" type="double">
        <unit basis="\kilogram" namespace="D-SI" />
        <comment>PLATINUM. Comparing this to elapsed is the invalid case.</comment>
      </variable>
      <variable name="speed" type="double">
        <unit basis="\kilo\metre\hour\tothe{-1}" namespace="D-SI" />
        <comment>GOLD: exercises prefix, juxtaposition and \tothe{n}.</comment>
      </variable>
      <variable name="height" type="double" default="0">
        <unit basis="meter" namespace="SI" />
        <comment>Legacy SI vocabulary — IMPROVABLE under D-SI (PTB17).</comment>
      </variable>
    </variables>
  </data>
  <model namespace="Reading">
    <variables>
      <variable name="ratio" type="double">
        <unit basis="\one" namespace="D-SI" />
        <comment>Explicitly dimensionless, not merely unit-less.</comment>
        <validate>ratio &gt;= 0</validate>
      </variable>
      <variable name="coolantTemp" type="double">
        <unit basis="\degreecelsius" namespace="D-SI" />
        <comment>Affine scale — offset, not just a factor.</comment>
      </variable>
      <variable name="dwellLimit" type="int" isconstant="true">500<unit basis="\second" namespace="D-SI" /></variable>
    </variables>
  </model>
  <model namespace="Verdict">
    <variables>
      <variable name="result" type="bool">false</variable>
    </variables>
  </model>
  <algorithm namespace="DwellCheck">
    <input model="SensorFeed" />
    <output model="Verdict" />
    <operations>
      <operation name="compareDwell" returns="bool">
        <comment>elapsed &lt; payloadMass — \second against \kilogram. Invalid.</comment>
      </operation>
      <operation name="normalise" returns="double">
        <unit basis="\one" namespace="D-SI" />
      </operation>
    </operations>
    <function>
      <expressions>
        <expression sequence="0" name="normalise">
          <Math>
            <math xmlns="http://www.w3.org/1998/Math/MathML">
              <apply>
                <divide />
                <ci>SensorFeed.elapsed</ci>
                <ci>Reading.dwellLimit</ci>
              </apply>
            </math>
          </Math>
        </expression>
        <expression sequence="1" name="within dwell?">
          <If input="SensorFeed">
            <parameters>
              <parameter position="0">
                <Less input="SensorFeed">
                  <parameters>
                    <parameter position="0">
                      <pathvariable type="double" namespace="SensorFeed.elapsed" />
                    </parameter>
                    <parameter position="1">
                      <pathvariable type="int" namespace="Reading.dwellLimit" />
                    </parameter>
                  </parameters>
                </Less>
              </parameter>
              <parameter position="1">
                <goto sequence="3" />
              </parameter>
            </parameters>
          </If>
        </expression>
        <expression sequence="2" name="reject">
          <Algorithm namespace="DwellCheck.reject" input="SensorFeed" output="Verdict" />
        </expression>
        <expression sequence="3" name="compare dwell (invalid)">
          <If input="SensorFeed">
            <parameters>
              <parameter position="0">
                <Less input="SensorFeed" output="Verdict.result">
                  <parameters>
                    <parameter position="0">
                      <pathvariable type="double" namespace="SensorFeed.elapsed" />
                    </parameter>
                    <parameter position="1">
                      <pathvariable type="double" namespace="SensorFeed.payloadMass" />
                    </parameter>
                  </parameters>
                </Less>
              </parameter>
              <parameter position="1">
                <goto sequence="0" />
              </parameter>
            </parameters>
          </If>
        </expression>
      </expressions>
    </function>
  </algorithm>
</gorp>