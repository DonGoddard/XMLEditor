/>\n</Planet>\n</fragment>\n"},{"fragmentId":"xml_frag_32d103","x":458.85772705078127,"y":290.416259765625,"xmlContent":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<fragment><Planet name=\"Earth\" type=\"Inner\" size=\"Medium\">\n  <Moon name=\"Luna\" />\n</Planet>\n</fragment>\n"},{"fragmentId":"xml_frag_8b8776","x":949.6611938476563,"y":326.71832275390627,"xmlContent":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<fragment><book id=\"bk104\">\n  <author>Corets, Eva</author>\n  <title>Oberon's Legacy</title>\n  <genre>Fantasy</genre>\n  <price>5.95</price>\n  <publish_date>2001-03-10</publish_date>\n  <description>In post-apocalypse England, the mysterious \n      agent known only as Oberon helps to create a new life \n      for the inhabitants of London. Sequel to Maeve \n      Ascendant.</description>\n</book>\n<book id=\"bk106\">\n  <author>Randall, Cynthia</author>\n  <title>Lover Birds</title>\n  <genre>Romance</genre>\n  <price>4.95</price>\n  <publish_date>2000-09-02</publish_date>\n  <description>When Carla meets Paul at an ornithology \n      conference, tempers fly as feathers get ruffled.</description>\n</book>\n<book id=\"bk109\">\n  <author>Kress, Peter</author>\n  <title>Paradox Lost</title>\n  <genre>Science Fiction</genre>\n  <price>6.95</price>\n  <publish_date>2000-11-02</publish_date>\n  <description>After an inadvertant trip through a Heisenberg\n      Uncertainty Device, James Salway discovers the problems \n      of being quantum.</description>\n</book>\n</fragment>\n"},{"fragmentId":"xml_frag_cb7cd0","x":669.4094848632813,"y":130.68731689453126,"xmlContent":"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<fragment><book id=\"bk103\">\n  <author>Corets, Eva</author>\n  <title>Maeve Ascendant</title>\n  <genre>Fantasy</genre>\n  <price>5.95</price>\n  <publish_date>2000-11-17</publish_date>\n  <description>After the collapse of a nanotechnology \n      society in England, the young survivors lay the \n      foundation for a new society.</description>\n</book>\n</fragment>\n"}],"dockLocationMode":4,"dockHidable":true,"dockIconSize":36.0}