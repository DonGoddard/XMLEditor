 <algorithm namespace=\\\"shinynewalgorithm\\\">\\n      <input model=\\\"orp\\\"/>\\n      <output model=\\\"result\\\"/>\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Algorithm namespace=\\\"uri.delegate\\\" input=\\\"model\\\" output=\\\"model\\\"/>\\n          </expression>\\n        </expressions>\\n      </function>\\n    </algorithm>\\n  </algorithms>\\n  <models>\\n    <model namespace=\\\"orp\\\">\\n      <variables>\\n        <variable name=\\\"limitofcheese\\\" type=\\\"int\\\" isimmutable=\\\"true\\\">500</variable>\\n        <variable name=\\\"harvey\\\" type=\\\"int\\\">17</variable>\\n        <variable name=\\\"irrelevant\\\" type=\\\"string\\\">\\\"More Than Five\\\"</variable>\\n      </variables>\\n      <pathvariables>\\n        <pathvariable path=\\\"timbucktu\\\" name=\\\"sunrise\\\" type=\\\"int\\\">89</pathvariable>\\n        <pathvariable path=\\\"timbucktu\\\" name=\\\"sunset\\\" type=\\\"int\\\">-22</pathvariable>\\n        <pathvariable path=\\\"timbucktu\\\" name=\\\"tanzania\\\" type=\\\"key\\\">9</pathvariable>\\n      </pathvariables>\\n      <arrays>\\n        <array path=\\\"local\\\" name=\\\"hillgiant\\\" type=\\\"[int]\\\">11, 17,\\n          4</array>\\n      </arrays>\\n    </model>\\n    <model namespace=\\\"escape\\\">\\n      <variables>\\n        <variable name=\\\"result\\\" type=\\\"bool\\\">false</variable>\\n      </variables>\\n    </model>\\n  </models>\\n</gorp>\",\"xmlPanelOpen\":false,\"xmlPanelHeight\":200.0,\"xmlPanelWidth\":340.0,\"modelPanelHeight\":220.0,\"xmlLockManualEdits\":false,\"xmlShowGorpRequest\":false,\"xmlSideBySide\":false,\"variableUnits\":[],\"algorithmInputModel\":\"orp\",\"algorithmOutputModel\":\"escape\",\"libraryExtraFoldersText\":\"\",\"librarySearchTerm\":\"\",\"libraryExtraFoldersSectionOpen\":false,\"librarySearchSectionOpen\":false,\"libraryCollapsedPaths\":[],\"activeAlgorithmIndex\":0,\"activeModelIndex\":0}","snapZoneId":0,"preSn