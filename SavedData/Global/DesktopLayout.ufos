{"version":1,"windows":[{"windowId":"XAMLCanvasLayoutApp_1","baseId":"XAMLCanvasLayoutApp","x":0.0,"y":0.0,"width":1500.0,"height":942.94775390625,"zOrder":2,"isMinimized":false,"isMaximized":true,"scrollX":0.0,"scrollY":0.0,"customData":"{\"equationXml\":\"<?xml version=\\\"1.0\\\" encoding=\\\"utf-8\\\"?>\\n<!-- gorpEndpoint: default -->\\n<!-- Using Gorp: Values & Variables, Computation, Comparison, Logic, Flow -->\\n<gorp>\\n  <expect>Unit handling, one test per algorithm.\\nMeasured on GORP 3561df2, 2026-09-14. The editor states each result unit on &lt;Math&gt;.\\n\\nAt a glance\\n  •  1–26 and 28 answer correctly\\n  •  27 answers wrong (a GORP bug)\\n  •  29–32 return HTTP 500\\n\\nSame quantity, units converted\\n  1.  AddSameUnit  →  8 m\\n  2.  AddKilometerAndMeter  →  2.5 km\\n  3.  AddHourAndMinute  →  1.5 h\\n  4.  AddLiterAndMilliliter  →  1.25 L\\n  5.  SubtractGramFromKilogram  →  1.5 kg\\n  6.  AddLiteralToMeasured  →  5 m\\n         the plain 2 takes x&apos;s unit\\n  7.  NegateMeasured  →  −7 m\\n  8.  GlucoseAdd  →  120 mg/dL\\n\\nA new quantity\\n  9.  AreaMeterTimesMeter  →  15 m²\\n  10. VolumeThreeLengths  →  24 m³\\n  11. EnergyNewtonTimesMeter  →  15 J\\n  12. PowerJoulePerSecond  →  25 W\\n  13. SpeedMeterPerSecond  →  2.5 m/s\\n  14. SpeedKilometerPerHour  →  45 km/h\\n  15. AccelerationSpeedOverTime  →  5 m/s²\\n  16. ForceMassTimesAcceleration  →  19.6 N\\n  17. PressureForceOverArea  →  25 Pa\\n  18. OhmsLawVoltsOverAmps  →  4 Ω\\n  19. FrequencyOneOverPeriod  →  2 Hz\\n  20. ReciprocalLength  →  0.5 1/m\\n\\nPlain numbers and exponents\\n  21. RatioSameUnit  →  0.5\\n         a plain fraction\\n  22. RatioMixedUnits  →  4\\n         a plain fraction; km and m convert\\n  23. ScaleByLiteral  →  6 m\\n  24. ScaleByPlainVariable  →  6 m\\n  25. SquareByLiteralExponent  →  9 m²\\n  26. CubeByLiteralExponent  →  27 m³\\n\\nTemperature\\n  27. TemperatureAddCelsius  →  25 °C\\n         WRONG TODAY: GORP answers 298.15 °C\\n         it adds both as absolute kelvin (293.15 + 278.15)\\n  28. TemperatureCelsiusPlusKelvin  →  25 °C\\n         GORP reads the 5 K as a difference, unlike test 27\\n\\nKnown GORP limits (HTTP 500 today)\\n  29. SquareRootOfArea  →  4 m\\n         fails even with the result unit stated\\n  30. PowerByVariableExponent  →  expected to fail\\n         the result unit depends on y&apos;s value\\n\\nShould be refused with a message\\n  31. AddPlainVariable  →  refuse\\n         meters plus a plain number; today a bare 500\\n  32. AddMismatchedUnits  →  refuse\\n         meters plus seconds; the editor flags it, GORP gives a bare 500</expect>\\n  <algorithms>\\n    <algorithm namespace=\\\"UnitTests.Units.AddSameUnit\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">3</x>\\n        <y unit=\\\"\\\\metre\\\">5</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AddKilometerAndMeter\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\kilo\\\\metre\\\">2</x>\\n        <y unit=\\\"\\\\metre\\\">500</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AddHourAndMinute\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\hour\\\">1</x>\\n        <y unit=\\\"\\\\minute\\\">30</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AddLiterAndMilliliter\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\litre\\\">1</x>\\n        <y unit=\\\"\\\\milli\\\\litre\\\">250</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.SubtractGramFromKilogram\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <minus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\kilogram\\\">2</x>\\n        <y unit=\\\"\\\\gram\\\">500</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AddLiteralToMeasured\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <cn>2</cn>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">3</x>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.NegateMeasured\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <minus/>\\n                  <ci>x</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">7</x>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.GlucoseAdd\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\milli\\\\gram\\\\deci\\\\litre\\\\tothe{-1}\\\">100</x>\\n        <y unit=\\\"\\\\milli\\\\gram\\\\deci\\\\litre\\\\tothe{-1}\\\">20</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AreaMeterTimesMeter\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <times/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">3</x>\\n        <y unit=\\\"\\\\metre\\\">5</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.VolumeThreeLengths\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <times/>\\n                  <apply>\\n                    <times/>\\n                    <ci>x</ci>\\n                    <ci>y</ci>\\n                  </apply>\\n                  <ci>z</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">2</x>\\n        <y unit=\\\"\\\\metre\\\">3</y>\\n        <z unit=\\\"\\\\metre\\\">4</z>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.EnergyNewtonTimesMeter\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <times/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\newton\\\">3</x>\\n        <y unit=\\\"\\\\metre\\\">5</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.PowerJoulePerSecond\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\joule\\\">100</x>\\n        <y unit=\\\"\\\\second\\\">4</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.SpeedMeterPerSecond\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">10</x>\\n        <y unit=\\\"\\\\second\\\">4</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.SpeedKilometerPerHour\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\kilo\\\\metre\\\">90</x>\\n        <y unit=\\\"\\\\hour\\\">2</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AccelerationSpeedOverTime\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\\second\\\\tothe{-1}\\\">10</x>\\n        <y unit=\\\"\\\\second\\\">2</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.ForceMassTimesAcceleration\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <times/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\kilogram\\\">2</x>\\n        <y unit=\\\"\\\\metre\\\\second\\\\tothe{-2}\\\">9.8</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.PressureForceOverArea\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\newton\\\">100</x>\\n        <y unit=\\\"\\\\metre\\\\tothe{2}\\\">4</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.OhmsLawVoltsOverAmps\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\volt\\\">12</x>\\n        <y unit=\\\"\\\\ampere\\\">3</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.FrequencyOneOverPeriod\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <cn>1</cn>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <y unit=\\\"\\\\second\\\">0.5</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.ReciprocalLength\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <cn>2</cn>\\n                  <ci>x</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">4</x>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.RatioSameUnit\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">3</x>\\n        <y unit=\\\"\\\\metre\\\">6</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.RatioMixedUnits\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\kilo\\\\metre\\\">1</x>\\n        <y unit=\\\"\\\\metre\\\">250</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.ScaleByLiteral\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <times/>\\n                  <cn>2</cn>\\n                  <ci>x</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">3</x>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.ScaleByPlainVariable\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n     