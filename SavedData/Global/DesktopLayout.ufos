rollY":0.0},{"baseId":"BrandStudio","x":826.4312744140625,"y":85.26188659667969,"width":560.2923583984375,"height":679.0499877929688,"scrollX":0.0,"scrollY":0.0},{"baseId":"XMLFileApp_desk_93ff67","x":350.4500732421875,"y":196.3993377685547,"width":799.713623046875,"height":499.5908203125,"scrollX":0.0,"scrollY":0.0},{"baseId":"ImageApp_desk_15ba8d","x":549.9181518554688,"y":196.3993377685547,"width":400.16363525390625,"height":499.5908203125,"scrollX":0.0,"scrollY":0.0},{"baseId":"AiDesignerApp","x":62.89978790283203,"y":174.840087890625,"width":1143.92333984375,"height":757.9957885742188,"scrollX":0.0,"scrollY":0.0},{"baseId":"XMLFileApp_desk_0ed690","x":250.17518615722656,"y":103.01331329345703,"width":999.649658203125,"height":600.210205078125,"scrollX":0.0,"scrollY":0.0},{"baseId":"XMLFileApp_desk_21a3f8","x":336.3699951171875,"y":86.19481658935547,"width":999.649658203125,"height":600.210205078125,"scrollX":0.0,"scrollY":0.0},{"baseId":"CgmApp","x":0.0,"y":0.0,"width":1500.0001220703125,"height":598.6602172851563,"scrollX":0.0,"scrollY":0.0},{"baseId":"AiDesignerApp_f3915407","x":484.66259765625,"y":317.99591064453125,"width":857.8731689453125,"height":514.31494140625,"scrollX":0.0,"scrollY":0.0},{"baseId":"AiDesignerApp_6f01a58f","x":105.31697845458984,"y":172.8016357421875,"width":906.9530029296875,"height":463.190185546875,"scrollX":0.0,"scrollY":0.0},{"baseId":"AiDesignerApp_7470431c","x":124.74437713623047,"y":76.68711853027344,"width":1016.3599853515625,"height":583.8445434570313,"scrollX":56.2371826171875,"scrollY":0.0},{"baseId":"AiDesignerApp_77b49567","x":150.30674743652344,"y":94.06953430175781,"width":1199.386474609375,"height":748.46630859375,"scrollX":573.05859375,"scrollY":332.8298034667969},{"baseId":"AiDesignerApp_26b56199","x":385.4805908203125,"y":71.57464599609375,"width":1000.0,"height":600.2045288085938,"scrollX":0.0,"scrollY":0.0},{"baseId":"AiDesignerApp_bc60fafd","x":250.51124572753906,"y":167.6891632080078,"width":1000.0,"height":600.2045288085938,"scrollX":0.0,"scrollY":0.0}],"windowLastCustomStates":[{"baseId":"XAMLCanvasLayoutApp","customData":"{\"equationXml\":\"<?xml version=\\\"1.0\\\" encoding=\\\"utf-8\\\"?>\\n<!-- gorpEndpoint: default -->\\n<!-- Using Gorp: Values & Variables, Computation, Comparison, Logic, Flow -->\\n<gorp>\\n  <expect>Unit handling, one test per algorithm.\\nMeasured on GORP 3561df2, 2026-09-14. The editor states each result unit on &lt;Math&gt;.\\n\\nAt a glance\\n  •  1–26 and 28 answer correctly\\n  •  27 answers wrong (a GORP bug)\\n  •  29–32 return HTTP 500\\n\\nSame quantity, units converted\\n  1.  AddSameUnit  →  8 m\\n  2.  AddKilometerAndMeter  →  2.5 km\\n  3.  AddHourAndMinute  →  1.5 h\\n  4.  AddLiterAndMilliliter  →  1.25 L\\n  5.  SubtractGramFromKilogram  →  1.5 kg\\n  6.  AddLiteralToMeasured  →  5 m\\n         the plain 2 takes x&apos;s unit\\n  7.  NegateMeasured  →  −7 m\\n  8.  GlucoseAdd  →  120 mg/dL\\n\\nA new quantity\\n  9.  AreaMeterTimesMeter  →  15 m²\\n  10. VolumeThreeLengths  →  24 m³\\n  11. EnergyNewtonTimesMeter  →  15 J\\n  12. PowerJoulePerSecond  →  25 W\\n  13. SpeedMeterPerSecond  →  2.5 m/s\\n  14. SpeedKilometerPerHour  →  45 km/h\\n  15. AccelerationSpeedOverTime  →  5 m/s²\\n  16. ForceMassTimesAcceleration  →  19.6 N\\n  17. PressureForceOverArea  →  25 Pa\\n  18. OhmsLawVoltsOverAmps  →  4 Ω\\n  19. FrequencyOneOverPeriod  →  2 Hz\\n  20. ReciprocalLength  →  0.5 1/m\\n\\nPlain numbers and exponents\\n  21. RatioSameUnit  →  0.5\\n         a plain fraction\\n  22. RatioMixedUnits  →  4\\n         a plain fraction; km and m convert\\n  23. ScaleByLiteral  →  6 m\\n  24. ScaleByPlainVariable  →  6 m\\n  25. SquareByLiteralExponent  →  9 m²\\n  26. CubeByLiteralExponent  →  27 m³\\n\\nTemperature\\n  27. TemperatureAddCelsius  →  25 °C\\n         WRONG TODAY: GORP answers 298.15 °C\\n         it adds both as absolute kelvin (293.15 + 278.15)\\n  28. TemperatureCelsiusPlusKelvin  →  25 °C\\n         GORP reads the 5 K as a difference, unlike test 27\\n\\nKnown GORP limits (HTTP 500 today)\\n  29. SquareRootOfArea  →  4 m\\n         fails even with the result unit stated\\n  30. PowerByVariableExponent  →  expected to fail\\n         the result unit depends on y&apos;s value\\n\\nShould be refused with a message\\n  31. AddPlainVariable  →  refuse\\n         meters plus a plain number; today a bare 500\\n  32. AddMismatchedUnits  →  refuse\\n         meters plus seconds; the editor flags it, GORP gives a bare 500</expect>\\n  <algorithms>\\n    <algorithm namespace=\\\"UnitTests.Units.AddSameUnit\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">3</x>\\n        <y unit=\\\"\\\\metre\\\">5</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AddKilometerAndMeter\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\kilo\\\\metre\\\">2</x>\\n        <y unit=\\\"\\\\metre\\\">500</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AddHourAndMinute\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\hour\\\">1</x>\\n        <y unit=\\\"\\\\minute\\\">30</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AddLiterAndMilliliter\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\litre\\\">1</x>\\n        <y unit=\\\"\\\\milli\\\\litre\\\">250</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.SubtractGramFromKilogram\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <minus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\kilogram\\\">2</x>\\n        <y unit=\\\"\\\\gram\\\">500</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AddLiteralToMeasured\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <cn>2</cn>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">3</x>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.NegateMeasured\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <minus/>\\n                  <ci>x</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">7</x>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.GlucoseAdd\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\milli\\\\gram\\\\deci\\\\litre\\\\tothe{-1}\\\">100</x>\\n        <y unit=\\\"\\\\milli\\\\gram\\\\deci\\\\litre\\\\tothe{-1}\\\">20</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AreaMeterTimesMeter\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  