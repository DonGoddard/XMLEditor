{"version":1,"windows":[{"windowId":"AiDesignerApp_1","baseId":"AiDesignerApp","x":67.48466491699219,"y":51.1247444152832,"width":1298.568603515625,"height":685.0715942382813,"zOrder":0,"isMinimized":false,"isMaximized":false,"scrollX":0.0,"scrollY":0.0,"customData":"{\"uml\":\"{\\\"xmlPanelOpen\\\":false,\\\"xmlPanelWidth\\\":320.0,\\\"xmlViewMode\\\":\\\"Tree\\\"}\",\"endpoint\":\"\",\"statePaneHeight\":240.0,\"view\":\"Class\",\"selected\":\"\",\"libraryCollapsed\":\"\",\"librarySort\":\"\",\"runs\":\"{\\\"designs\\\":[{\\\"path\\\":\\\"Global/Files/AiDesign/AI Design 12.xml\\\",\\\"runs\\\":[{\\\"when\\\":\\\"2026-09-13T00:47:58Z\\\",\\\"version\\\":\\\"v0.1.260912.1905\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":289,\\\"bytes\\\":627,\\\"summary\\\":\\\"Session B27259… · user BD38F4… · 1 action, 1 item\\\",\\\"body\\\":\\\"<Response>\\\\r\\\\n  <Status>OK</Status>\\\\r\\\\n  <Seraphim.Internet.Session Key=\\\\\\\"B27259CA3054F2C2\\\\\\\">\\\\r\\\\n    <Variables>\\\\r\\\\n      <User>BD38F412285F7349</User>\\\\r\\\\n      <Site>961FAE20E6D37A62</Site>\\\\r\\\\n      <CreationDate Collapse=\\\\\\\"Earliest\\\\\\\">9/13/2026 12:47:58 AM</CreationDate>\\\\r\\\\n      <LastTouched Collapse=\\\\\\\"Latest\\\\\\\">9/13/2026 12:47:58 AM</LastTouched>\\\\r\\\\n      <DeliverySpeed Unit=\\\\\\\"m/s\\\\\\\" Collapse=\\\\\\\"Monotone\\\\\\\">13.46</DeliverySpeed>\\\\r\\\\n      <Driver Collapse=\\\\\\\"Vote\\\\\\\">Gonk</Driver>\\\\r\\\\n      <Deliveries Collapse=\\\\\\\"Sum\\\\\\\">21</Deliveries>\\\\r\\\\n    </Variables>\\\\r\\\\n    <Actions>\\\\r\\\\n      <Action Key=\\\\\\\"B2346325014CC77F\\\\\\\" />\\\\r\\\\n    </Actions>\\\\r\\\\n    <Items>\\\\r\\\\n      <Item Key=\\\\\\\"C379D552DE21D41A\\\\\\\" />\\\\r\\\\n    </Items>\\\\r\\\\n  </Seraphim.Internet.Session>\\\\r\\\\n</Response>\\\",\\\"sent\\\":\\\"<?xml version=\\\\\\\"1.0\\\\\\\" encoding=\\\\\\\"utf-8\\\\\\\"?><xaiml version=\\\\\\\"1\\\\\\\"><name>AI Design 12</name><gorp name=\\\\\\\"AI Design 12\\\\\\\"><data namespace=\\\\\\\"Data\\\\\\\"><variables><variable name=\\\\\\\"id\\\\\\\" type=\\\\\\\"key\\\\\\\" /><variable name=\\\\\\\"value\\\\\\\" type=\\\\\\\"double\\\\\\\" collapse=\\\\\\\"Monotone\\\\\\\"><unit basis=\\\\\\\"\\\\\\\\one\\\\\\\" namespace=\\\\\\\"D-SI\\\\\\\" /></variable></variables></data><model namespace=\\\\\\\"Model\\\\\\\"><variables><variable name=\\\\\\\"value\\\\\\\" type=\\\\\\\"double\\\\\\\" collapse=\\\\\\\"Monotone\\\\\\\"><unit basis=\\\\\\\"\\\\\\\\one\\\\\\\" namespace=\\\\\\\"D-SI\\\\\\\" /></variable></variables></model><algorithm namespace=\\\\\\\"Algorithm\\\\\\\"><input model=\\\\\\\"Data\\\\\\\" /><output model=\\\\\\\"Model\\\\\\\" /><operations><operation name=\\\\\\\"run\\\\\\\" /></operations></algorithm></gorp><inputs /></xaiml>\\\"}]},{\\\"path\\\":\\\"Global/Files/AiDesign/UnitTests/06 Composed Input.xml\\\",\\\"runs\\\":[{\\\"when\\\":\\\"2026-09-13T04:59:43Z\\\",\\\"version\\\":\\\"vRecompiled since last build\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":219,\\\"bytes\\\":1602,\\\"summary\\\":\\\"Session 4A1874… · user 23EA4D… · 1 action, 1 item\\\",\\\"body\\\":\\\"<Response>\\\\r\\\\n  <Status>OK</Status>\\\\r\\\\n  <Seraphim.Internet.Session Key=\\\\\\\"4A187480F9CAFCCA\\\\\\\">\\\\r\\\\n    <Variables>\\\\r\\\\n      <User>23EA4D5DF6F67606</User>\\\\r\\\\n      <Site>5F9964FA3F6C2F19</Site>\\\\r\\\\n      <CreationDate Collapse=\\\\\\\"Earliest\\\\\\\">9/13/2026 4:59:43 AM</CreationDate>\\\\r\\\\n      <LastTouched Collapse=\\\\\\\"Latest\\\\\\\">9/13/2026 4:59:43 AM</LastTouched>\\\\r\\\\n      <DeliverySpeed Unit=\\\\\\\"m/s\\\\\\\" Collapse=\\\\\\\"Monotone\\\\\\\">3.30</DeliverySpeed>\\\\r\\\\n      <Driver Collapse=\\\\\\\"Vote\\\\\\\">Gonk</Driver>\\\\r\\\\n      <Deliveries Collapse=\\\\\\\"Sum\\\\\\\">33</Deliveries>\\\\r\\\\n    </Variables>\\\\r\\\\n    <Actions>\\\\r\\\\n      <Action Key=\\\\\\\"62AA8CDC52D2CAA8\\\\\\\" />\\\\r\\\\n    </Actions>\\\\r\\\\n    <Items>\\\\r\\\\n      <Item Key=\\\\\\\"E7317C32C7049371\\\\\\\" />\\\\r\\\\n    </Items>\\\\r\\\\n  </Seraphim.Internet.Session>\\\\r\\\\n</Response>\\\",\\\"sent\\\":\\\"<?xml version=\\\\\\\"1.0\\\\\\\" encoding=\\\\\\\"utf-8\\\\\\\"?><xaiml version=\\\\\\\"1\\\\\\\"><name>06 Composed Input</name><gorp name=\\\\\\\"06 Composed Input\\\\\\\"><comment view=\\\\\\\"class\\\\\\\">SAI allows ONE model on a port. An algorithm that needs two reads a composed model instead: the model Both holds one row per source, each a key whose of= names the model it stands for, and Add takes Both as its single input.\\\\n\\\\nThe canvas draws a reference arrow out of each row — derived from the of=, never drawn by hand.</comment><expect>Check finds nothing: Add has exactly one input and one output, and both references resolve.\\\\n\\\\nWire a second model straight onto the input port instead and Check must report it as over SAI's one-per-port limit, offering Compose inputs as the fix.</expect><model namespace=\\\\\\\"ut.comp.Left\\\\\\\"><variables><variable name=\\\\\\\"a\\\\\\\" type=\\\\\\\"double\\\\\\\" collapse=\\\\\\\"Monotone\\\\\\\"><unit basis=\\\\\\\"\\\\\\\\one\\\\\\\" namespace=\\\\\\\"D-SI\\\\\\\" /></variable></variables></model><model namespace=\\\\\\\"ut.comp.Right\\\\\\\"><variables><variable name=\\\\\\\"b\\\\\\\" type=\\\\\\\"double\\\\\\\" collapse=\\\\\\\"Monotone\\\\\\\"><unit basis=\\\\\\\"\\\\\\\\one\\\\\\\" namespace=\\\\\\\"D-SI\\\\\\\" /></variable></variables></model><model namespace=\\\\\\\"ut.comp.Both\\\\\\\"><variables><variable name=\\\\\\\"left\\\\\\\" type=\\\\\\\"key\\\\\\\" of=\\\\\\\"ut.comp.Left\\\\\\\" /><variable name=\\\\\\\"right\\\\\\\" type=\\\\\\\"key\\\\\\\" of=\\\\\\\"ut.…\\\"},{\\\"when\\\":\\\"2026-09-13T04:56:23Z\\\",\\\"version\\\":\\\"vRecompiled since last build\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":145,\\\"bytes\\\":1602,\\\"summary\\\":\\\"Session 0BA02B… · user DE08EC… · 1 action, 1 item\\\"}]},{\\\"path\\\":\\\"Global/Files/AiDesign/AI Design 8.xml\\\",\\\"runs\\\":[{\\\"when\\\":\\\"2026-09-13T18:46:41Z\\\",\\\"version\\\":\\\"vRecompiled since last build\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":126,\\\"bytes\\\":625,\\\"summary\\\":\\\"Session 7BECA8… · user 431927… · 1 action, 1 item\\\",\\\"body\\\":\\\"<Response>\\\\r\\\\n  <Status>OK</Status>\\\\r\\\\n  <Seraphim.Internet.Session Key=\\\\\\\"7BECA87B40BFBF6A\\\\\\\">\\\\r\\\\n    <Variables>\\\\r\\\\n      <User>431927B4BD1427D5</User>\\\\r\\\\n      <Site>09BE99556AD5E541</Site>\\\\r\\\\n      <CreationDate Collapse=\\\\\\\"Earliest\\\\\\\">9/13/2026 6:46:41 PM</CreationDate>\\\\r\\\\n      <LastTouched Collapse=\\\\\\\"Latest\\\\\\\">9/13/2026 6:46:41 PM</LastTouched>\\\\r\\\\n      <DeliverySpeed Unit=\\\\\\\"m/s\\\\\\\" Collapse=\\\\\\\"Monotone\\\\\\\">9.71</DeliverySpeed>\\\\r\\\\n      <Driver Collapse=\\\\\\\"Vote\\\\\\\">Gonk</Driver>\\\\r\\\\n      <Deliveries Collapse=\\\\\\\"Sum\\\\\\\">19</Deliveries>\\\\r\\\\n    </Variables>\\\\r\\\\n    <Actions>\\\\r\\\\n      <Action Key=\\\\\\\"A5E5557D45955B2A\\\\\\\" />\\\\r\\\\n    </Actions>\\\\r\\\\n    <Items>\\\\r\\\\n      <Item Key=\\\\\\\"0CF903E8C8AAB94A\\\\\\\" />\\\\r\\\\n    </Items>\\\\r\\\\n  </Seraphim.Internet.Session>\\\\r\\\\n</Response>\\\",\\\"sent\\\":\\\"<?xml version=\\\\\\\"1.0\\\\\\\" encoding=\\\\\\\"utf-8\\\\\\\"?><xaiml version=\\\\\\\"1\\\\\\\"><name>AI Design 8</name><gorp name=\\\\\\\"AI Design 8\\\\\\\"><data namespace=\\\\\\\"Data\\\\\\\"><variables><variable name=\\\\\\\"id\\\\\\\" type=\\\\\\\"key\\\\\\\" /><variable name=\\\\\\\"value\\\\\\\" type=\\\\\\\"double\\\\\\\" collapse=\\\\\\\"Monotone\\\\\\\"><unit basis=\\\\\\\"\\\\\\\\one\\\\\\\" namespace=\\\\\\\"D-SI\\\\\\\" /></variable></variables></data><model namespace=\\\\\\\"Model\\\\\\\"><variables><variable name=\\\\\\\"value\\\\\\\" type=\\\\\\\"double\\\\\\\" collapse=\\\\\\\"Monotone\\\\\\\"><unit basis=\\\\\\\"\\\\\\\\one\\\\\\\" namespace=\\\\\\\"D-SI\\\\\\\" /></variable></variables></model><algorithm namespace=\\\\\\\"Algorithm\\\\\\\"><input model=\\\\\\\"Data\\\\\\\" /><output model=\\\\\\\"Model\\\\\\\" /><operations><operation name=\\\\\\\"run\\\\\\\" /></operations></algorithm></gorp><inputs /></xaiml>\\\"},{\\\"when\\\":\\\"2026-09-13T18:45:12Z\\\",\\\"version\\\":\\\"vRecompiled since last build\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":125,\\\"bytes\\\":625,\\\"summary\\\":\\\"Session EA7762… · user 76C579… · 1 action, 1 item\\\"},{\\\"when\\\":\\\"2026-09-13T18:43:48Z\\\",\\\"version\\\":\\\"vRecompiled since last build\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":229,\\\"bytes\\\":625,\\\"summary\\\":\\\"Session 710907… · user 4CAE62… · 1 action, 1 item\\\"},{\\\"when\\\":\\\"2026-09-13T18:34:29Z\\\",\\\"version\\\":\\\"vRecompiled since last build\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":177,\\\"bytes\\\":625,\\\"summary\\\":\\\"Session 618592… · user EBCF1B… · 1 action, 1 item\\\"},{\\\"when\\\":\\\"2026-09-13T00:45:23Z\\\",\\\"version\\\":\\\"v0.1.260912.1905\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":355,\\\"bytes\\\":625,\\\"summary\\\":\\\"Session 1AEEEC… · user E85FD0… · 1 action, 1 item\\\"}]},{\\\"path\\\":\\\"Global/Files/AiDesign/AI Design 2.xml\\\",\\\"runs\\\":[{\\\"when\\\":\\\"2026-09-14T00:15:31Z\\\",\\\"version\\\":\\\"vRecompiled since last build\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":false,\\\"status\\\":\\\"502\\\",\\\"ms\\\":174,\\\"bytes\\\":625,\\\"summary\\\":\\\"HTTP/1.1 502 Bad Gateway\\\",\\\"body\\\":\\\"error code: 502\\\\n\\\",\\\"sent\\\":\\\"<?xml version=\\\\\\\"1.0\\\\\\\" encoding=\\\\\\\"utf-8\\\\\\\"?><xaiml version=\\\\\\\"1\\\\\\\"><name>AI Design 2</name><gorp name=\\\\\\\"AI Design 2\\\\\\\"><data namespace=\\\\\\\"Data\\\\\\\"><variables><variable name=\\\\\\\"id\\\\\\\" type=\\\\\\\"key\\\\\\\" /><variable name=\\\\\\\"value\\\\\\\" type=\\\\\\\"double\\\\\\\" collapse=\\\\\\\"Monotone\\\\\\\"><unit basis=\\\\\\\"\\\\\\\\one\\\\\\\" namespace=\\\\\\\"D-SI\\\\\\\" /></variable></variables></data><model namespace=\\\\\\\"Model\\\\\\\"><variables><variable name=\\\\\\\"value\\\\\\\" type=\\\\\\\"double\\\\\\\" collapse=\\\\\\\"Monotone\\\\\\\"><unit basis=\\\\\\\"\\\\\\\\one\\\\\\\" namespace=\\\\\\\"D-SI\\\\\\\" /></variable></variables></model><algorithm namespace=\\\\\\\"Algorithm\\\\\\\"><input model=\\\\\\\"Data\\\\\\\" /><output model=\\\\\\\"Model\\\\\\\" /><operations><operation name=\\\\\\\"run\\\\\\\" /></operations></algorithm></gorp><inputs /></xaiml>\\\"},{\\\"when\\\":\\\"2026-09-13T18:57:47Z\\\",\\\"version\\\":\\\"vRecompiled since last build\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":158,\\\"bytes\\\":625,\\\"summary\\\":\\\"Session 5C3C88… · user BA50CF… · 1 action, 1 item\\\"},{\\\"when\\\":\\\"2026-09-13T00:32:17Z\\\",\\\"version\\\":\\\"v0.1.260912.1905\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":487,\\\"bytes\\\":625,\\\"summary\\\":\\\"Session 21E678… · user 3C7A6C… · 1 action, 1 item\\\"}]},{\\\"path\\\":\\\"Global/Files/AiDesign/UnitTests/01 Pass Through.xml\\\",\\\"runs\\\":[{\\\"when\\\":\\\"2026-09-14T14:27:20Z\\\",\\\"version\\\":\\\"v0.1.260914.1000\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":136,\\\"bytes\\\":1408,\\\"summary\\\":\\\"Session E47E78… · user CF6628… · 1 action, 1 item\\\",\\\"body\\\":\\\"<Response>\\\\r\\\\n  <Status>OK</Status>\\\\r\\\\n  <Seraphim.Internet.Session Key=\\\\\\\"E47E78D4840B9BE7\\\\\\\">\\\\r\\\\n    <Variables>\\\\r\\\\n      <User>CF662828856ABA5C</User>\\\\r\\\\n      <Site>D960A6F21B3CA7E5</Site>\\\\r\\\\n      <CreationDate Collapse=\\\\\\\"Earliest\\\\\\\">9/14/2026 2:27:20 PM</CreationDate>\\\\r\\\\n      <LastTouched Collapse=\\\\\\\"Latest\\\\\\\">9/14/2026 2:27:20 PM</LastTouched>\\\\r\\\\n      <DeliverySpeed Unit=\\\\\\\"m/s\\\\\\\" Collapse=\\\\\\\"Monotone\\\\\\\">1.59</DeliverySpeed>\\\\r\\\\n      <Driver Collapse=\\\\\\\"Vote\\\\\\\">Gonk</Driver>\\\\r\\\\n      <Deliveries Collapse=\\\\\\\"Sum\\\\\\\">21</Deliveries>\\\\r\\\\n    </Variables>\\\\r\\\\n    <Actions>\\\\r\\\\n      <Action Key=\\\\\\\"D35274B7C02095A6\\\\\\\" />\\\\r\\\\n    </Actions>\\\\r\\\\n    <Items>\\\\r\\\\n      <Item Key=\\\\\\\"B0E934B3C93727C1\\\\\\\" />\\\\r\\\\n    </Items>\\\\r\\\\n  </Seraphim.Internet.Session>\\\\r\\\\n</Response>\\\",\\\"sent\\\":\\\"<?xml version=\\\\\\\"1.0\\\\\\\" encoding=\\\\\\\"utf-8\\\\\\\"?><xaiml version=\\\\\\\"1\\\\\\\"><name>01 Pass Through</name><gorp name=\\\\\\\"01 Pass Through\\\\\\\"><comment view=\\\\\\\"class\\\\\\\">The smallest design that is still complete. One model carries a single dimensionless number in, one algorithm copies it, one model carries it out.\\\\n\\\\nEvery variable is measured (\\\\\\\\one) and says how repeat observations merge (Monotone), which is everything the no-fail rule asks for. Nothing else is here on purpose: if this one does not check clean, the problem is in the checker rather than in the design.</comment><expect>Check finds nothing — 0 errors, 0 warnings — so Run is available.\\\\n\\\\nRun posts the design to xmlIT and comes back with status OK. That proves the transport and nothing more: xmlIT is a deliberate placeholder that reads the body and discards it, so no computed value comes back for any design on this shelf.</expect><model namespace=\\\\\\\"ut.pass.In\\\\\\\"><variables><variable name=\\\\\\\"value\\\\\\\" type=\\\\\\\"double\\\\\\\" collapse=\\\\\\\"Monotone\\\\\\\"><unit basis=\\\\\\\"\\\\\\\\one\\\\\\\" namespace=\\\\\\\"D-SI\\\\\\\" /></variable></variables></model><model namespace=\\\\\\\"ut.pass.Out\\\\\\\"><variables><variable name=\\\\\\\"result\\\\\\\" type=\\\\\\\"double\\\\\\\" collapse=\\\\\\\"Monotone\\\\\\\"><unit basis=\\\\\\\"\\\\\\\\one\\\\\\\" namespace=\\\\\\\"D-SI\\\\\\\" /></variable></variables></…\\\"},{\\\"when\\\":\\\"2026-09-13T04:36:23Z\\\",\\\"version\\\":\\\"vRecompiled since last build\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":214,\\\"bytes\\\":1408,\\\"summary\\\":\\\"Session 29C23F… · user F054C4… · 1 action, 1 item\\\"},{\\\"when\\\":\\\"2026-09-13T04:09:26Z\\\",\\\"version\\\":\\\"vRecompiled since last build\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":267,\\\"bytes\\\":1408,\\\"summary\\\":\\\"Session 94778F… · user 825215… · 1 action, 1 item\\\"}]},{\\\"path\\\":\\\"Global/Files/AiDesign/UnitTests/03 Compatible Rule.xml\\\",\\\"runs\\\":[{\\\"when\\\":\\\"2026-09-14T17:49:25Z\\\",\\\"version\\\":\\\"vRecompiled since last build\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":245,\\\"bytes\\\":1228,\\\"summary\\\":\\\"Session 812F16… · user 22BA7F… · 1 action, 1 item\\\",\\\"body\\\":\\\"<Response>\\\\r\\\\n  <Status>OK</Status>\\\\r\\\\n  <Seraphim.Internet.Session Key=\\\\\\\"812F16296214E4B0\\\\\\\">\\\\r\\\\n    <Variables>\\\\r\\\\n      <User>22BA7F8743C65640</User>\\\\r\\\\n      <Site>4B26184788D6A5AC</Site>\\\\r\\\\n      <CreationDate Collapse=\\\\\\\"Earliest\\\\\\\">9/14/2026 5:49:26 PM</CreationDate>\\\\r\\\\n      <LastTouched Collapse=\\\\\\\"Latest\\\\\\\">9/14/2026 5:49:26 PM</LastTouched>\\\\r\\\\n      <DeliverySpeed Unit=\\\\\\\"m/s\\\\\\\" Collapse=\\\\\\\"Monotone\\\\\\\">9.70</DeliverySpeed>\\\\r\\\\n      <Driver Collapse=\\\\\\\"Vote\\\\\\\">Gonk</Driver>\\\\r\\\\n      <Deliveries Collapse=\\\\\\\"Sum\\\\\\\">45</Deliveries>\\\\r\\\\n    </Variables>\\\\r\\\\n    <Actions>\\\\r\\\\n      <Action Key=\\\\\\\"49870AC357ECE945\\\\\\\" />\\\\r\\\\n    </Actions>\\\\r\\\\n    <Items>\\\\r\\\\n      <Item Key=\\\\\\\"4C571E1685F1D91B\\\\\\\" />\\\\r\\\\n    </Items>\\\\r\\\\n  </Seraphim.Internet.Session>\\\\r\\\\n</Response>\\\",\\\"sent\\\":\\\"<?xml version=\\\\\\\"1.0\\\\\\\" encoding=\\\\\\\"utf-8\\\\\\\"?><xaiml version=\\\\\\\"1\\\\\\\"><name>03 Compatible Rule</name><gorp name=\\\\\\\"03 Compatible Rule\\\\\\\"><comment view=\\\\\\\"class\\\\\\\">A validate rule that holds up. low and high are both in metres, so \\\\\\\"low &lt; high\\\\\\\" is a comparison the unit rules allow.\\\\n\\\\nThis is the positive half of the pairing Gorp.rtf opens with. N01 is the half that must be refused.</comment><expect>Check finds nothing: the two sides of the rule share a dimension, so the comparison is legal, and Run comes back OK.\\\\n\\\\nChange either unit to a different quantity and Check must report the rule as incompatible — that is N01.</expect><model namespace=\\\\\\\"ut.rule.Span\\\\\\\"><variables><variable name=\\\\\\\"low\\\\\\\" type=\\\\\\\"double\\\\\\\" collapse=\\\\\\\"Monotone\\\\\\\"><unit basis=\\\\\\\"\\\\\\\\metre\\\\\\\" namespace=\\\\\\\"D-SI\\\\\\\" /></variable><variable name=\\\\\\\"high\\\\\\\" type=\\\\\\\"double\\\\\\\" collapse=\\\\\\\"Monotone\\\\\\\"><unit basis=\\\\\\\"\\\\\\\\metre\\\\\\\" namespace=\\\\\\\"D-SI\\\\\\\" /><validate>low &lt; high</validate></variable></variables></model><model namespace=\\\\\\\"ut.rule.Verdict\\\\\\\"><variables><variable name=\\\\\\\"ok\\\\\\\" type=\\\\\\\"bool\\\\\\\" /></variables></model><algorithm namespace=\\\\\\\"ut.rule.Check\\\\\\\"><input model=\\\\\\\"ut.rule.Span\\\\\\\" /><output model=\\\\\\\"ut.rule.Verdict\\\\\\\" /><operations><operation name=\\\\\\\"check\\\\\\\" returns=\\\\\\\"bool\\\\\\\" /></operations></algorithm…\\\"},{\\\"when\\\":\\\"2026-09-14T14:31:14Z\\\",\\\"version\\\":\\\"v0.1.260914.1000\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":275,\\\"bytes\\\":1228,\\\"summary\\\":\\\"Session 34EC41… · user A2D06D… · 1 action, 1 item\\\"},{\\\"when\\\":\\\"2026-09-14T14:26:58Z\\\",\\\"version\\\":\\\"v0.1.260914.1000\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":225,\\\"bytes\\\":1228,\\\"summary\\\":\\\"Session 88052B… · user A30E02… · 1 action, 1 item\\\"},{\\\"when\\\":\\\"2026-09-13T04:37:44Z\\\",\\\"version\\\":\\\"vRecompiled since last build\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":205,\\\"bytes\\\":1228,\\\"summary\\\":\\\"Session 49C496… · user 6E7742… · 1 action, 1 item\\\"}]}]}\",\"notesX\":954.0625,\"notesY\":143.03091430664063,\"notesW\":320.0,\"notesH\":226.01226806640625,\"notesOpen\":false,\"runsX\":17.875274658203125,\"runsY\":280.1346740722656,\"runsW\":475.70098876953125,\"runsH\":371.5320129394531,\"runsOpen\":true,\"runsRaw\":false,\"runsNoWrap\":false,\"runsFolds\":\"Sent,Received\",\"runsScrollY\":6.600127696990967,\"notesScrollY\":0.0,\"lockedPath\":\"Global/Files/AiDesign/UnitTests/03 Compatible Rule.xml\",\"lockedUnitTest\":true,\"wireDSi\":false,\"endpointOpen\":true}","snapZoneId":0,"preSnapX":0.0,"preSnapY":0.0,"preSnapWidth":0.0,"preSnapHeight":0.0,"appInstanceData":{"instanceId":"AiDesignerApp","appId":"AiDesignerApp","displayName":"03 Compatible Rule","iconOverrideUrl":"","filePath":"","fileUrl":"https://raw.githubusercontent.com/dongoddard/XMLEditor/main/SavedData/Global/Files/AiDesign/AI%20Skunk%20Don.xml","isReadOnly":false,"isPinned":true,"dockPosition":6,"fileSize":0}},{"windowId":"XAMLCanvasLayoutApp_0","baseId":"XAMLCanvasLayoutApp","x":0.0,"y":0.0,"width":1500.0,"height":935.5828247070313,"zOrder":1,"isMinimized":false,"isMaximized":false,"scrollX":0.0,"scrollY":1320.552734375,"customData":"{\"equationXml\":\"<?xml version=\\\"1.0\\\" encoding=\\\"utf-8\\\"?>\\n<!-- gorpEndpoint: default -->\\n<!-- Using Gorp: Values & Variables, Computation, Comparison, Logic, Flow -->\\n<gorp>\\n  <expect>Unit handling, one test per algorithm.\\nMeasured on GORP 3561df2, 2026-09-14. The editor states each result unit on &lt;Math&gt;.\\n\\nAt a glance\\n  •  1–26 and 28 answer correctly\\n  •  27 answers wrong (a GORP bug)\\n  •  29–32 return HTTP 500\\n\\nSame quantity, units converted\\n  1.  AddSameUnit  →  8 m\\n  2.  AddKilometerAndMeter  →  2.5 km\\n  3.  AddHourAndMinute  →  1.5 h\\n  4.  AddLiterAndMilliliter  →  1.25 L\\n  5.  SubtractGramFromKilogram  →  1.5 kg\\n  6.  AddLiteralToMeasured  →  5 m\\n         the plain 2 takes x&apos;s unit\\n  7.  NegateMeasured  →  −7 m\\n  8.  GlucoseAdd  →  120 mg/dL\\n\\nA new quantity\\n  9.  AreaMeterTimesMeter  →  15 m²\\n  10. VolumeThreeLengths  →  24 m³\\n  11. EnergyNewtonTimesMeter  →  15 J\\n  12. PowerJoulePerSecond  →  25 W\\n  13. SpeedMeterPerSecond  →  2.5 m/s\\n  14. SpeedKilometerPerHour  →  45 km/h\\n  15. AccelerationSpeedOverTime  →  5 m/s²\\n  16. ForceMassTimesAcceleration  →  19.6 N\\n  17. PressureForceOverArea  →  25 Pa\\n  18. OhmsLawVoltsOverAmps  →  4 Ω\\n  19. FrequencyOneOverPeriod  →  2 Hz\\n  20. ReciprocalLength  →  0.5 1/m\\n\\nPlain numbers and exponents\\n  21. RatioSameUnit  →  0.5\\n         a plain fraction\\n  22. RatioMixedUnits  →  4\\n         a plain fraction; km and m convert\\n  23. ScaleByLiteral  →  6 m\\n  24. ScaleByPlainVariable  →  6 m\\n  25. SquareByLiteralExponent  →  9 m²\\n  26. CubeByLiteralExponent  →  27 m³\\n\\nTemperature\\n  27. TemperatureAddCelsius  →  25 °C\\n         WRONG TODAY: GORP answers 298.15 °C\\n         it adds both as absolute kelvin (293.15 + 278.15)\\n  28. TemperatureCelsiusPlusKelvin  →  25 °C\\n         GORP reads the 5 K as a difference, unlike test 27\\n\\nKnown GORP limits (HTTP 500 today)\\n  29. SquareRootOfArea  →  4 m\\n         fails even with the result unit stated\\n  30. PowerByVariableExponent  →  expected to fail\\n         the result unit depends on y&apos;s value\\n\\nShould be refused with a message\\n  31. AddPlainVariable  →  refuse\\n         meters plus a plain number; today a bare 500\\n  32. AddMismatchedUnits  →  refuse\\n         meters plus seconds; the editor flags it, GORP gives a bare 500</expect>\\n  <algorithms>\\n    <algorithm namespace=\\\"UnitTests.Units.AddSameUnit\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">3</x>\\n        <y unit=\\\"\\\\metre\\\">5</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AddKilometerAndMeter\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\kilo\\\\metre\\\">2</x>\\n        <y unit=\\\"\\\\metre\\\">500</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AddHourAndMinute\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\hour\\\">1</x>\\n        <y unit=\\\"\\\\minute\\\">30</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AddLiterAndMilliliter\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\litre\\\">1</x>\\n        <y unit=\\\"\\\\milli\\\\litre\\\">250</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.SubtractGramFromKilogram\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <minus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\kilogram\\\">2</x>\\n        <y unit=\\\"\\\\gram\\\">500</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AddLiteralToMeasured\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <cn>2</cn>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">3</x>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.NegateMeasured\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <minus/>\\n                  <ci>x</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">7</x>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.GlucoseAdd\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <plus/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\milli\\\\gram\\\\deci\\\\litre\\\\tothe{-1}\\\">100</x>\\n        <y unit=\\\"\\\\milli\\\\gram\\\\deci\\\\litre\\\\tothe{-1}\\\">20</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AreaMeterTimesMeter\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <times/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">3</x>\\n        <y unit=\\\"\\\\metre\\\">5</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.VolumeThreeLengths\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <times/>\\n                  <apply>\\n                    <times/>\\n                    <ci>x</ci>\\n                    <ci>y</ci>\\n                  </apply>\\n                  <ci>z</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">2</x>\\n        <y unit=\\\"\\\\metre\\\">3</y>\\n        <z unit=\\\"\\\\metre\\\">4</z>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.EnergyNewtonTimesMeter\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <times/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\newton\\\">3</x>\\n        <y unit=\\\"\\\\metre\\\">5</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.PowerJoulePerSecond\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\joule\\\">100</x>\\n        <y unit=\\\"\\\\second\\\">4</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.SpeedMeterPerSecond\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">10</x>\\n        <y unit=\\\"\\\\second\\\">4</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.SpeedKilometerPerHour\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\kilo\\\\metre\\\">90</x>\\n        <y unit=\\\"\\\\hour\\\">2</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.AccelerationSpeedOverTime\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\\second\\\\tothe{-1}\\\">10</x>\\n        <y unit=\\\"\\\\second\\\">2</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.ForceMassTimesAcceleration\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <times/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\kilogram\\\">2</x>\\n        <y unit=\\\"\\\\metre\\\\second\\\\tothe{-2}\\\">9.8</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.PressureForceOverArea\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\newton\\\">100</x>\\n        <y unit=\\\"\\\\metre\\\\tothe{2}\\\">4</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.OhmsLawVoltsOverAmps\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\volt\\\">12</x>\\n        <y unit=\\\"\\\\ampere\\\">3</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.FrequencyOneOverPeriod\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <cn>1</cn>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <y unit=\\\"\\\\second\\\">0.5</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.ReciprocalLength\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <cn>2</cn>\\n                  <ci>x</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">4</x>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.RatioSameUnit\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">3</x>\\n        <y unit=\\\"\\\\metre\\\">6</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.RatioMixedUnits\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <divide/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\kilo\\\\metre\\\">1</x>\\n        <y unit=\\\"\\\\metre\\\">250</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.ScaleByLiteral\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <times/>\\n                  <cn>2</cn>\\n                  <ci>x</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">3</x>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.ScaleByPlainVariable\\\">\\n      <function>\\n        <expressions>\\n          <expression sequence=\\\"0\\\">\\n            <Math>\\n              <math xmlns=\\\"http://www.w3.org/1998/Math/MathML\\\">\\n                <apply>\\n                  <times/>\\n                  <ci>x</ci>\\n                  <ci>y</ci>\\n                </apply>\\n              </math>\\n            </Math>\\n          </expression>\\n        </expressions>\\n      </function>\\n      <inputs>\\n        <x unit=\\\"\\\\metre\\\">3</x>\\n        <y>2</y>\\n      </inputs>\\n    </algorithm>\\n    <algorithm namespace=\\\"UnitTests.Units.SquareByLiteralExponent\\\">\\n      <function>\\n        <expr