n      <User>F054C415B355FD7F</User>\\\\r\\\\n      <Site>BA28729B49E6383C</Site>\\\\r\\\\n      <CreationDate Collapse=\\\\\\\"Earliest\\\\\\\">9/13/2026 4:36:23 AM</CreationDate>\\\\r\\\\n      <LastTouched Collapse=\\\\\\\"Latest\\\\\\\">9/13/2026 4:36:23 AM</LastTouched>\\\\r\\\\n      <DeliverySpeed Unit=\\\\\\\"m/s\\\\\\\" Collapse=\\\\\\\"Monotone\\\\\\\">0.42</DeliverySpeed>\\\\r\\\\n      <Driver Collapse=\\\\\\\"Vote\\\\\\\">Gonk</Driver>\\\\r\\\\n      <Deliveries Collapse=\\\\\\\"Sum\\\\\\\">22</Deliveries>\\\\r\\\\n    </Variables>\\\\r\\\\n    <Actions>\\\\r\\\\n      <Action Key=\\\\\\\"706FF829F42CA845\\\\\\\" />\\\\r\\\\n    </Actions>\\\\r\\\\n    <Items>\\\\r\\\\n      <Item Key=\\\\\\\"ADDE464A766585D4\\\\\\\" />\\\\r\\\\n    </Items>\\\\r\\\\n  </Seraphim.Internet.Session>\\\\r\\\\n</Response>\\\",\\\"sent\\\":\\\"<?xml version=\\\\\\\"1.0\\\\\\\" encoding=\\\\\\\"utf-8\\\\\\\"?><xaiml version=\\\\\\\"1\\\\\\\"><name>01 Pass Through</name><gorp name=\\\\\\\"01 Pass Through\\\\\\\"><comment view=\\\\\\\"class\\\\\\\">The smallest design that is still complete. One model carries a single dimensionless number in, one algorithm copies it, one model carries it out.\\\\n\\\\nEvery variable is measured (\\\\\\\\one) and says how repeat observations merge (Monotone), which is everything the no-fail rule asks for. Nothing else is here on purpose: if this one does not check clean, the problem is in the checker rather than in the design.</comment><expect>Check finds nothing — 0 errors, 0 warnings — so Run is available.\\\\n\\\\nRun posts the design to xmlIT and comes back with status OK. That proves the transport and nothing more: xmlIT is a deliberate placeholder that reads the body and discards it, so no computed value comes back for any design on this shelf.</expect><model namespace=\\\\\\\"ut.pass.In\\\\\\\"><variables><variable name=\\\\\\\"value\\\\\\\" type=\\\\\\\"double\\\\\\\" collapse=\\\\\\\"Monotone\\\\\\\"><unit basis=\\\\\\\"\\\\\\\\one\\\\\\\" namespace=\\\\\\\"D-SI\\\\\\\" /></variable></variables></model><model namespace=\\\\\\\"ut.pass.Out\\\\\\\"><variables><variable name=\\\\\\\"result\\\\\\\" type=\\\\\\\"double\\\\\\\" collapse=\\\\\\\"Monotone\\\\\\\"><unit basis=\\\\\\\"\\\\\\\\one\\\\\\\" namespace=\\\\\\\"D-SI\\\\\\\" /></variable></variables></…\\\"},{\\\"when\\\":\\\"2026-09-13T04:09:26Z\\\",\\\"version\\\":\\\"vRecompiled since last build\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":267,\\\"bytes\\\":1408,\\\"summary\\\":\\\"Session 94778F… · user 825215… · 1 action, 1 item\\\"}]},{\\\"path\\\":\\\"Global/Files/AiDesign/UnitTests/03 Compatible Rule.xml\\\",\\\"runs\\\":[{\\\"when\\\":\\\"2026-09-13T04:37:44Z\\\",\\\"version\\\":\\\"vRecompiled since last build\\\",\\\"endpoint\\\":\\\"portal\\\",\\\"ok\\\":true,\\\"status\\\":\\\"200\\\",\\\"ms\\\":205,\\\"bytes\\\":1228,\\\"summary\\\":\\\"Session 49C496… · user 6E7742… · 1 action, 1 item\\\",\\\"body\\\":\\\"<Response>\\\\r\\\\n  <Status>OK</Status>\\\\r\\\\n  <Seraphim.Internet.Session Key=\\\\\\\"49C496B6E790355D\\\\\\\">\\\\r\\\\n    <Variables>\\\\r\\\\n      <User>6E77420F1265E378</User>\\\\r\\\\n      <Site>1BD1E10DDCC87B39</Site>\\\\r\\\\n      <CreationDate Collapse=\\\\\\\"Earliest\\\\\\\">9/13/2026 4:37:45 AM</CreationDate>\\\\r\\\\n      <LastTouched Collapse=\\\\\\\"Latest\\\\\\\">9/13/2026 4:37:45 AM</LastTouched>\\\\r\\\\n      <DeliverySpeed Unit=\\\\\\\"m/s\\\\\\\" Collapse=\\\\\\\"Monotone\\\\\\\">1.57</DeliverySpeed>\\\\r\\\\n      <Driver Collapse=\\\\\\\"Vote\\\\\\\">Gonk</Driver>\\\\r\\\\n      <Deliveries Collapse=\\\\\\\"Sum\\\\\\\">44</Deliveries>\\\\r\\\\n    </Variables>\\\\r\\\\n    <Actions>\\\\r\\\\n      <Action Key=\\\\\\\"F3C4EFA41B198B0C\\\\\\\" />\\\\r\\\\n    </Actions>\\\\r\\\\n    <Items>\\\\r\\\\n      <Item Key=\\\\\\\"44E0445FEA011B76\\\\\\\" />\\\\r\\\\n    </Items>\\\\r\\\\n  </Seraphim.Internet.Session>\\\\r\\\\n</Response>\\\",\\\"sent\\\":\\\"<?xm