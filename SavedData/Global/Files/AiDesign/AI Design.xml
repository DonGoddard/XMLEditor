<?xml version="1.0" encoding="utf-16"?>
<gorp name="AI Designer">
  <!-- nos-uml-state {"mode":"ai-design","title":"AI Designer","layout":{"ai.sample.CustomerRecords":{"x":18.4,"y":27.61,"w":327.96,"h":150},"ai.sample.TransactionLog":{"x":352.44,"y":6341.27,"w":280,"h":150},"ai.sample.ChurnPredictor":{"x":746.42,"y":27.61,"w":406.8,"h":150},"ai.sample.ScoreAndRank":{"x":397.75,"y":58.28,"w":280,"h":100}},"rels":[{"from":"ai.sample.CustomerRecords","to":"ai.sample.ScoreAndRank","type":"Input"},{"from":"ai.sample.ScoreAndRank","to":"ai.sample.ChurnPredictor","type":"Output"}]} -->
  <data namespace="ai.sample.CustomerRecords">
    <variables>
      <variable name="id" type="key" />
      <variable name="tenure" type="int" collapse="Sum" />
      <variable name="monthly" type="double" collapse="Monotone" />
      <variable name="churned" type="bool" />
      <variable name="signedUp" type="utcdatetime" collapse="Latest" />
    </variables>
  </data>
  <data namespace="ai.sample.TransactionLog">
    <variables>
      <variable name="id" type="guid" />
      <variable name="customer" type="key" />
      <variable name="amounts" type="[double]" />
      <variable name="source" type="uri" />
    </variables>
  </data>
  <model namespace="ai.sample.ChurnPredictor">
    <variables>
      <variable name="features" type="[double]" collapse="Vote" />
      <variable name="weights" type="[double]" collapse="Vote">
        <unit basis="\kilogram" namespace="D-SI" />
      </variable>
      <variable name="bias" type="double = 0.0" collapse="Antimonotone">
        <unit basis="\hertz" namespace="D-SI" />
      </variable>
      <variable name="threshold" type="double = 0.5" collapse="Monotone">
        <unit basis="\hertz" namespace="D-SI" />
      </variable>
      <variable name="labels" type="[symbol]" />
    </variables>
    <operations>
      <operation name="predict" returns="double" />
    </operations>
  </model>
  <algorithm namespace="ai.sample.ScoreAndRank">
    <input model="ai.sample.CustomerRecords" />
    <output model="ai.sample.ChurnPredictor" />
    <operations>
      <operation name="score" returns="double" />
      <operation name="rank" returns="[key]" />
      <operation name="explain" returns="string" />
    </operations>
    <function>
      <expressions>
        <expression sequence="0" name="score">
          <Math>
            <math xmlns="http://www.w3.org/1998/Math/MathML">
              <apply>
                <plus />
                <ci>ai.sample.ChurnPredictor.bias</ci>
                <ci>ai.sample.CustomerRecords.monthly</ci>
              </apply>
            </math>
          </Math>
        </expression>
        <expression sequence="1" name="low spender?">
          <If guard="ai.sample.CustomerRecords.monthly &lt; 20">
            <parameters>
              <parameter position="0">
                <Less with="model">
                  <parameters>
                    <parameter namespace="Less.P0" of="ai.sample.CustomerRecords.monthly" />
                    <parameter namespace="Less.P1" is="20" />
                  </parameters>
                </Less>
              </parameter>
              <parameter position="1">
                <goto sequence="3" />
              </parameter>
            </parameters>
          </If>
        </expression>
        <expression sequence="2" name="rank" delegate="ai.sample.Rank" limit="1" />
        <expression sequence="3" name="explain">
          <Algorithm namespace="ai.sample.Explain" input="ai.sample.CustomerRecords" output="ai.sample.ChurnPredictor" />
        </expression>
        <expression sequence="4" name="more customers?">
          <If guard="ai.sample.CustomerRecords.tenure &gt; 0">
            <parameters>
              <parameter position="0">
                <Greater with="model">
                  <parameters>
                    <parameter namespace="Greater.P0" of="ai.sample.CustomerRecords.tenure" />
                    <parameter namespace="Greater.P1" is="0" />
                  </parameters>
                </Greater>
              </parameter>
              <parameter position="1">
                <goto sequence="0" />
              </parameter>
            </parameters>
          </If>
        </expression>
        <expression sequence="5" name="step">
          <If guard="elapsed &lt; payloadMass">
            <parameters>
              <parameter position="0">
                <Less with="model">
                  <parameters>
                    <parameter namespace="Less.P0" of="elapsed" />
                    <parameter namespace="Less.P1" of="payloadMass" />
                  </parameters>
                </Less>
              </parameter>
              <parameter position="1">
                <goto sequence="0" />
              </parameter>
            </parameters>
          </If>
        </expression>
      </expressions>
    </function>
  </algorithm>
</gorp>