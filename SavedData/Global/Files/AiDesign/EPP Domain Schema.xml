      <variable name="exDate" type="utcdatetime" occurs="0..1" />
      <variable name="trDate" type="utcdatetime" occurs="0..1" />
      <variable name="authInfo" type="authInfoType" occurs="0..1" />
    </variables>
  </model>
  <model namespace="statusType">
    <variables>
      <variable name="value" type="string" />
      <variable name="s" type="enum" xsd-type="statusValueType" values="clientDeleteProhibited | clientHold | clientRenewProhibited | clientTransferProhibited | clientUpdateProhibited | inactive | ok | pendingCreate | pendingDelete | pendingRenew | pendingTransfer | pendingUpdate | serverDeleteProhibited | serverHold | serverRenewProhibited | serverTransferProhibited | serverUpdateProhibited" xsd="attribute" />
