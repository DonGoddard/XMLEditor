    </variables>
  </model>
  <model namespace="chgType">
    <variables>
      <variable name="registrant" type="string" xsd-type="clIDChgType" occurs="0..1" minLength="0" maxLength="16" />
      <variable name="authInfo" type="authInfoChgType" occurs="0..1" />
    </variables>
  </model>
  <model namespace="authInfoChgType">
    <variables>
      <variable name="pw" type="pwAuthInfoType" occurs="0..1" />
      <variable name="ext" type="extAuthInfoType" occurs="0..1" />
      <variable name="null" type="string" occurs="0..1" />
    </variables>
  </model>
  <model namespace="chkDataType">
    <variables>
      <variable name="cd" type="[checkType]" occurs="1..*" />
    </variables>
  </model>
  <model namespace="checkType">
    <variables>
