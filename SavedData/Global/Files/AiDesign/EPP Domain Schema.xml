      <variable name="trStatus" type="enum" xsd-type="trStatusType" values="clientApproved | clientCancelled | clientRejected | pending | serverApproved | serverCancelled" />
      <variable name="reID" type="string" xsd-type="clIDType" minLength="3" maxLength="16" />
      <variable name="reDate" type="utcdatetime" />
      <variable name="acID" type="string" xsd-type="clIDType" minLength="3" maxLength="16" />
      <variable name="acDate" type="utcdatetime" />
      <variable name="exDate" type="utcdatetime" occurs="0..1" />
    </variables>
  </model>
  <model namespace="addrType" xsd-file="host-1.0.xsd">
    <variables>
      <variable name="value" type="string" xsd-type="addrStringType" minLength="3" maxLength="45" />
