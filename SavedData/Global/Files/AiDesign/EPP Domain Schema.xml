  <comment view="class">EPP Domain — the domain-name mapping of the Extensible Provisioning Protocol (domain-1.0.xsd, RFC 5731), with the types it borrows from eppcom-1.0.xsd and epp-1.0.xsd, converted into AI Designer models.

EPP is how domain-name registrars talk to registries (the operators behind .com, .org and the rest): every command and response is XML defined by these schemas. This one covers domain objects — create, check, info, renew, transfer and update — with name servers, host attributes, contacts, authorization info, registration periods and status codes. The models marked xsd-file came from the imported schemas: this example shows several schemas that import one another, read as one model.

Source: https://github.com/mganss/XmlSchemaClassGenerator/tree/master/XmlSchemaClassGenerator.Tests/xsd/epp
Domain mapping (RFC 5731): https://www.rfc-editor.org/rfc/rfc5731
The protocol (RFC 5730): https://www.rfc-editor.org/rfc/rfc5730
The schemas are IETF code components, available under the Simplified BSD License.</comment>
  <model namespace="createType">
    <variables>
      <variable name="name" type="string" xsd-type="labelType" minLength="1" maxLength="255" />
      <variable name="period" type="periodType" occurs="0..1" />
      <variable name="ns" type="nsType" occurs="0..1" />
      <variable name="registrant" type="string" xsd-type="clIDType" occurs="0..1" minLength="3" maxLength="16" />
      <variable name="contact" type="[contactType]" occurs="0..*" />
      <variable name="authInfo" type="authInfoType" />
    </variables>
  </model>
  <model namespace="periodType">
    <variables>
      <variable name="value" type="int" collapse="Monotone" xsd-type="pLimitType" minInclusive="1" maxInclusive="99">
        <unit basis="\one" namespace="D-SI" />
      </variable>
      <variable name="unit" type="enum" xsd-type="pUnitType" values="y | m" xsd="attribute" />
    </variables>
  </model>
  <model namespace="nsType">
    <variables>
      <variable name="hostObj" type="[string]" xsd-type="labelType" occurs="0..*" minLength="1" maxLength="255" />
      <variable name="hostAttr" type="[hostAttrType]" occurs="0..*" />
    </variables>
  </model>
  <model namespace="hostAttrType">
    <variables>
      <variable name="hostName" type="string" xsd-type="labelType" minLength="1" maxLength="255" />
      <variable name="hostAddr" type="[addrType]" occurs="0..*" />
    </variables>
  </model>
  <model namespace="contactType">
    <variables>
      <variable name="value" type="string" xsd-type="clIDType" minLength="3" maxLength="16" />
      <variable name="type" type="enum" xsd-type="contactAttrType" occurs="0..1" values="admin | billing | tech" xsd="attribute" />
    </variables>
  </model>
  <model namespace="authInfoType">
    <variables>
      <variable name="pw" type="pwAuthInfoType" occurs="0..1" />
      <variable name="ext" type="extAuthInfoType" occurs="0..1" />
    </variables>
  </model>
  <model namespace="sNameType">
    <variables>
      <variable name="name" type="string" xsd-type="labelType" minLength="1" maxLength="255" />
    </variables>
  </model>
  <model namespace="mNameType">
    <variables>
      <variable name="name" type="[string]" xsd-type="labelType" occurs="1..*" minLength="1" maxLength="255" />
    </variables>
  </model>
  <model namespace="infoType">
    <variables>
      <variable name="name" type="infoNameType" />
      <variable name="authInfo" type="authInfoType" occurs="0..1" />
    </variables>
  </model>
  <model namespace="infoNameType">
    <variables>
      <variable name="value" type="string" xsd-type="labelType" minLength="1" maxLength="255" />
      <variable name="hosts" type="enum" xsd-type="hostsType" occurs="0..1" values="all | del | none | sub" xsd="attribute" />
    </variables>
  </model>
  <model namespace="renewType">
    <variables>
      <variable name="name" type="string" xsd-type="labelType" minLength="1" maxLength="255" />
      <variable name="curExpDate" type="date" />
      <variable name="period" type="periodType" occurs="0..1" />
    </variables>
  </model>
  <model namespace="transferType">
    <variables>
      <variable name="name" type="string" xsd-type="labelType" minLength="1" maxLength="255" />
      <variable name="period" type="periodType" occurs="0..1" />
      <variable name="authInfo" type="authInfoType" occurs="0..1" />
    </variables>
  </model>
  <model namespace="updateType">
    <variables>
      <variable name="name" type="string" xsd-type="labelType" minLength="1" maxLength="255" />
      <variable name="add" type="addRemType" occurs="0..1" />
      <variable name="rem" type="addRemType" occurs="0..1" />
      <variable name="chg" type="chgType" occurs="0..1" />
    </variables>
  </model>
  <model namespace="addRemType">
