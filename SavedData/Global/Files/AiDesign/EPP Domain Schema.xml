    </variables>
  </model>
  <model namespace="creDataType">
    <variables>
      <variable name="name" type="string" xsd-type="labelType" minLength="1" maxLength="255" />
      <variable name="crDate" type="utcdatetime" />
      <variable name="exDate" type="utcdatetime" occurs="0..1" />
    </variables>
  </model>
  <model namespace="infDataType">
    <variables>
      <variable name="name" type="string" xsd-type="labelType" minLength="1" maxLength="255" />
      <variable name="roid" type="string" xsd-type="roidType" pattern="(\w|_){1,80}-\w{1,8}" />
      <variable name="status" type="[statusType]" occurs="0..11" />
      <variable name="registrant" type="string" xsd-type="clIDType" occurs="0..1" minLength="3" maxLength="16" />
      <variable name="contact" type="[contactType]" occurs="0..*" />
      <variable name="ns" type="nsType" occurs="0..1" />
      <variable name="host" type="[string]" xsd-type="labelType" occurs="0..*" minLength="1" maxLength="255" />
      <variable name="clID" type="string" xsd-type="clIDType" minLength="3" maxLength="16" />
      <variable name="crID" type="string" xsd-type="clIDType" occurs="0..1" minLength="3" maxLength="16" />
      <variable name="crDate" type="utcdatetime" occurs="0..1" />
      <variable name="upID" type="string" xsd-type="clIDType" occurs="0..1" minLength="3" maxLength="16" />
