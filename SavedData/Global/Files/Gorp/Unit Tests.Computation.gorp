<?xml version="1.0" encoding="utf-8"?>
<!-- gorpEndpoint: default -->
<!-- Using Gorp: Values & Variables, Computation, Comparison, Logic, Flow -->
<gorp>
  <algorithms>
    <algorithm namespace="Unit Tests.Computation.Add">
      <function>
        <expressions>
          <expression sequence="0">
            <Math>
              <math xmlns="http://www.w3.org/1998/Math/MathML">
                <apply>
                  <plus/>
                <ci>x</ci>
                <ci>y</ci>
                </apply>
              </math>
            </Math>
          </expression>
        </expressions>
      </function>
      <inputs>
        <x>3</x>
        <y>5</y>
      </inputs>
    </algorithm>
    <algorithm namespace="Unit Tests.Computation.Subtract">
      <function>
        <expressions>
          <expression sequence="0">
            <Math>
              <math xmlns="http://www.w3.org/1998/Math/MathML">
                <apply>
                  <minus/>
                <ci>x</ci>
                <ci>y</ci>
                </apply>
              </math>
            </Math>
          </expression>
        </expressions>
      </function>
      <inputs>
        <x>3</x>
        <y>5</y>
      </inputs>
    </algorithm>
    <algorithm namespace="Unit Tests.Computation.Multiply">
      <function>
        <expressions>
          <expression sequence="0">
            <Math>
              <math xmlns="http://www.w3.org/1998/Math/MathML">
                <apply>
                  <times/>
                <ci>x</ci>
                <ci>y</ci>
                </apply>
              </math>
            </Math>
          </expression>
        </expressions>
      </function>
      <inputs>
        <x>3</x>
        <y>5</y>
      </inputs>
    </algorithm>
    <algorithm namespace="Unit Tests.Computation.Divide">
      <function>
        <expressions>
          <expression sequence="0">
            <Math>
              <math xmlns="http://www.w3.org/1998/Math/MathML">
                <apply>
                  <divide/>
                <ci>x</ci>
                <ci>y</ci>
                </apply>
              </math>
            </Math>
          </expression>
        </expressions>
      </function>
      <inputs>
        <x>10</x>
        <y>4</y>
      </inputs>
    </algorithm>
    <algorithm namespace="Unit Tests.Computation.Power">
      <function>
        <expressions>
          <expression sequence="0">
            <Math>
              <math xmlns="http://www.w3.org/1998/Math/MathML">
                <apply>
                  <power/>
                <ci>x</ci>
                <ci>y</ci>
                </apply>
              </math>
            </Math>
          </expression>
        </expressions>
      </function>
      <inputs>
        <x>2</x>
        <y>5</y>
      </inputs>
    </algorithm>
    <algorithm namespace="Unit Tests.Computation.SquareRoot">
      <function>
        <expressions>
          <expression sequence="0">
            <Math>
              <math xmlns="http://www.w3.org/1998/Math/MathML">
                <apply>
                  <root/>
                <ci>x</ci>
                </apply>
              </math>
            </Math>
          </expression>
        </expressions>
      </function>
      <inputs>
        <x>9</x>
      </inputs>
    </algorithm>
    <algorithm namespace="Unit Tests.Computation.Negate">
      <function>
        <expressions>
          <expression sequence="0">
            <Math>
              <math xmlns="http://www.w3.org/1998/Math/MathML">
                <apply>
                  <minus/>
                <ci>x</ci>
                </apply>
              </math>
            </Math>
          </expression>
        </expressions>
      </function>
      <inputs>
        <x>7</x>
      </inputs>
    </algorithm>
    <algorithm namespace="Unit Tests.Computation.Parentheses">
      <function>
        <expressions>
          <expression sequence="0">
            <Math>
              <math xmlns="http://www.w3.org/1998/Math/MathML">
                <apply>
                  <times/>
                  <apply>
                    <plus/>
                  <ci>x</ci>
                  <ci>y</ci>
                  </apply>
                <ci>z</ci>
                </apply>
              </math>
            </Math>
          </expression>
        </expressions>
      </function>
      <inputs>
        <x>2</x>
        <y>3</y>
        <z>4</z>
      </inputs>
    </algorithm>
  </algorithms>
</gorp>
