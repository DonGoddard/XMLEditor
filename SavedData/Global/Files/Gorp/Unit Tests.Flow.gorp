<?xml version="1.0" encoding="utf-8"?>
<!-- gorpEndpoint: default -->
<!-- Using Gorp: Values & Variables, Computation, Comparison, Logic, Flow -->
<gorp>
  <algorithms>
    <algorithm namespace="Unit Tests.Flow.If">
      <function>
        <expressions>
          <expression sequence="0">
            <If>
              <parameters>
                <parameter position="0">
                  <Less>
                    <parameters>
                      <parameter position="0">
                        <pathvariable type="int" namespace="x"/>
                      </parameter>
                      <parameter position="1">
                        <pathvariable type="int" namespace="y"/>
                      </parameter>
                    </parameters>
                  </Less>
                </parameter>
                <parameter position="1">
                  <goto sequence="0"/>
                </parameter>
              </parameters>
            </If>
          </expression>
        </expressions>
      </function>
      <inputs>
        <x>3</x>
        <y>5</y>
      </inputs>
    </algorithm>
    <algorithm namespace="Unit Tests.Flow.Call">
      <function>
        <expressions>
          <expression sequence="0">
            <Algorithm namespace="Unit Tests.Computation.Add" input="orp" output="orp"/>
          </expression>
        </expressions>
      </function>
    </algorithm>
    <algorithm namespace="Unit Tests.Flow.Goto">
      <function>
        <expressions>
          <expression sequence="0">
            <Less>
              <parameters>
                <parameter position="0">
                  <pathvariable type="int" namespace="x"/>
                </parameter>
                <parameter position="1">
                  <pathvariable type="int" namespace="y"/>
                </parameter>
              </parameters>
            </Less>
          </expression>
          <expression sequence="1">
            <goto sequence="0"/>
          </expression>
        </expressions>
      </function>
      <inputs>
        <x>3</x>
        <y>5</y>
      </inputs>
    </algorithm>
    <algorithm namespace="Unit Tests.Flow.Exists">
      <function>
        <expressions>
          <expression sequence="0">
            <Exists>
              <parameters>
                <parameter position="0" with="orp">
                  <variables type="int"/>
                  <pathvariables type="int" namespace="orp.set"/>
                </parameter>
                <parameter position="1">
                  <Less>
                    <parameters>
                      <parameter position="0">
                        <uses symbol="s"/>
                      </parameter>
                      <parameter position="1">
                        <pathvariable type="int" namespace="y"/>
                      </parameter>
                    </parameters>
                  </Less>
                </parameter>
              </parameters>
            </Exists>
          </expression>
        </expressions>
      </function>
      <inputs>
        <y>5</y>
      </inputs>
    </algorithm>
    <algorithm namespace="Unit Tests.Flow.ForAll">
      <function>
        <expressions>
          <expression sequence="0">
            <Forall>
              <parameters>
                <parameter position="0">
                  <pathvariable type="int" namespace="orp.set"/>
                </parameter>
                <parameter position="1">
                  <Math>
                    <math xmlns="http://www.w3.org/1998/Math/MathML">
                      <apply><plus/><ci>x</ci><cn>1</cn></apply>
                    </math>
                  </Math>
                </parameter>
              </parameters>
            </Forall>
          </expression>
        </expressions>
      </function>
      <inputs>
        <x>3</x>
      </inputs>
    </algorithm>
    <algorithm namespace="Unit Tests.Flow.Filter">
      <function>
        <expressions>
          <expression sequence="0">
            <Filter>
              <parameters>
                <parameter position="0">
                  <pathvariable type="int" namespace="orp.set"/>
                </parameter>
                <parameter position="1">
                  <Math>
                    <math xmlns="http://www.w3.org/1998/Math/MathML">
                      <apply><plus/><ci>x</ci><cn>1</cn></apply>
                    </math>
                  </Math>
                </parameter>
              </parameters>
            </Filter>
          </expression>
        </expressions>
      </function>
      <inputs>
        <x>3</x>
      </inputs>
    </algorithm>
  </algorithms>
</gorp>
