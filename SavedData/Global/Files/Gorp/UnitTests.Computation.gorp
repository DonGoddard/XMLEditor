<?xml version="1.0" encoding="utf-8"?><!-- gorpEndpoint: default --><!-- Using Gorp: Values & Variables, Computation, Comparison, Logic, Flow --><gorp><expect>On GORP 3561df2 (2026-09-14) every measured term carries its unit, and the request declares the result unit on &lt;Math&gt;. Add, Subtract, Negate and Parentheses answer in meters; Multiply answers 15 square meters (Area/SquareMeter); Divide answers 2.5 as a plain fraction (Ratio/DecimalFraction). Power and SquareRoot are EXPECTED TO FAIL (HTTP 500): a variable exponent leaves the result unit unknowable, and a fractional power of a measured value is not supported yet. Parentheses keeps z plain: x + y*z with z in meters would add meters to square meters.</expect><algorithms><algorithm namespace="UnitTests.Computation.Add"><function><expressions><expression sequence="0"><Math><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><plus/><ci>x</ci><ci>y</ci></apply></math></Math></expression></expressions></function><inputs><x unit="\metre">3</x><y unit="\metre">5</y></inputs></algorithm><algorithm namespace="UnitTests.Computation.Subtract"><function><expressions><expression sequence="0"><Math><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><minus/><ci>x</ci><ci>y</ci></apply></math></Math></expression></expressions></function><inputs><x unit="\metre">3</x><y unit="\metre">5</y></inputs></algorithm><algorithm namespace="UnitTests.Computation.Multiply"><function><expressions><expression sequence="0"><Math><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><times/><ci>x</ci><ci>y</ci></apply></math></Math></expression></expressions></function><inputs><x unit="\metre">3</x><y unit="\metre">5</y></inputs></algorithm><algorithm namespace="UnitTests.Computation.Divide"><function><expressions><expression sequence="0"><Math><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><divide/><ci>x</ci><ci>y</ci></apply></math></Math></expression></expressions></function><inputs><x unit="\metre">10</x><y unit="\metre">4</y></inputs></algorithm><algorithm namespace="UnitTests.Computation.Power"><function><expressions><expression sequence="0"><Math><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><power/><ci>x</ci><ci>y</ci></apply></math></Math></expression></expressions></function><inputs><x unit="\metre">2</x><y>5</y></inputs></algorithm><algorithm namespace="UnitTests.Computation.SquareRoot"><function><expressions><expression sequence="0"><Math><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><root/><ci>x</ci></apply></math></Math></expression></expressions></function><inputs><x unit="\metre">9</x></inputs></algorithm><algorithm namespace="UnitTests.Computation.Negate"><function><expressions><expression sequence="0"><Math><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><minus/><ci>x</ci></apply></math></Math></expression></expressions></function><inputs><x unit="\metre">7</x></inputs></algorithm><algorithm namespace="UnitTests.Computation.Parentheses"><function><expressions><expression sequence="0"><Math><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><plus/><ci>x</ci><apply><times/><ci>y</ci><ci>z</ci></apply></apply></math></Math></expression></expressions></function><inputs><x unit="\metre">2</x><y unit="\metre">3</y><z>4</z></inputs></algorithm></algorithms></gorp>