<?xml version="1.0" encoding="utf-8"?><!-- gorpEndpoint: default --><!-- Using Gorp: Values & Variables, Computation, Comparison, Logic, Flow --><gorp><expect>On GORP 1.0.158: Add, Subtract, Negate and Parentheses answer in metres; Multiply and Divide answer in metres too, because y is a plain number (a measured value times or divided by a plain number keeps its unit). Power and SquareRoot are EXPECTED TO FAIL (HTTP 500): the server cannot yet raise a measured value to a power. Multiplying two measured values (m x m = area) is the ambiguity Nick is still working on.</expect><algorithms><algorithm namespace="UnitTests.Computation.Add"><function><expressions><expression sequence="0"><Math><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><plus/><ci>x</ci><ci>y</ci></apply></math></Math></expression></expressions></function><inputs><x unit="\metre">3</x><y unit="\metre">5</y></inputs></algorithm><algorithm namespace="UnitTests.Computation.Subtract"><function><expressions><expression sequence="0"><Math><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><minus/><ci>x</ci><ci>y</ci></apply></math></Math></expression></expressions></function><inputs><x unit="\metre">3</x><y unit="\metre">5</y></inputs></algorithm><algorithm namespace="UnitTests.Computation.Multiply"><function><expressions><expression sequence="0"><Math><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><times/><ci>x</ci><ci>y</ci></apply></math></Math></expression></expressions></function><inputs><x unit="\metre">3</x><y>5</y></inputs></algorithm><algorithm namespace="UnitTests.Computation.Divide"><function><expressions><expression sequence="0"><Math><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><divide/><ci>x</ci><ci>y</ci></apply></math></Math></expression></expressions></function><inputs><x unit="\metre">10</x><y>4</y></inputs></algorithm><algorithm namespace="UnitTests.Computation.Power"><function><expressions><expression sequence="0"><Math><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><power/><ci>x</ci><ci>y</ci></apply></math></Math></expression></expressions></function><inputs><x unit="\metre">2</x><y>5</y></inputs></algorithm><algorithm namespace="UnitTests.Computation.SquareRoot"><function><expressions><expression sequence="0"><Math><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><root/><ci>x</ci></apply></math></Math></expression></expressions></function><inputs><x unit="\metre">9</x></inputs></algorithm><algorithm namespace="UnitTests.Computation.Negate"><function><expressions><expression sequence="0"><Math><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><minus/><ci>x</ci></apply></math></Math></expression></expressions></function><inputs><x unit="\metre">7</x></inputs></algorithm><algorithm namespace="UnitTests.Computation.Parentheses"><function><expressions><expression sequence="0"><Math><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><plus/><ci>x</ci><apply><times/><ci>y</ci><ci>z</ci></apply></apply></math></Math></expression></expressions></function><inputs><x unit="\metre">2</x><y unit="\metre">3</y><z>4</z></inputs></algorithm></algorithms></gorp>