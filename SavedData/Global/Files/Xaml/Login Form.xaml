<Window xmlns:nos="http://nos.dev/datacontext" x:Class="LoginDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="420" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
  <nos:DataContext nos:mode="json">
    <nos:Json><![CDATA[{
  "Title": "Hello World"
}]]></nos:Json>
    <nos:Gorp><![CDATA[<gorp>
  <models>
    <model namespace="data">
      <variables>
        <variable name="Title" type="string">Hello World</variable>
        <variable name="Count" type="int">42</variable>
      </variables>
    </model>
  </models>
</gorp>]]></nos:Gorp>
  </nos:DataContext>
    <!-- Hand-crafted sample: a realistic login form.
         Demonstrates: nested StackPanels, Border, TextBlock, TextBox,
         PasswordBox, Button, CheckBox, horizontal layout, margin/padding. -->

    <Border Background="#F5F5F5">
        <StackPanel VerticalAlignment="Center" Margin="40,0">

            <!-- Logo / App name -->
            <Border Background="#2B579A" CornerRadius="50" Width="80" Height="80"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="N" Foreground="White" FontSize="40" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Welcome back"
                       FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Sign in to continue"
                       Foreground="#888888"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <!-- Username -->
            <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Name="txtUsername"
                     Height="36"
                     Padding="8,6"
                     FontSize="14"
                     Margin="0,0,0,14"/>

            <!-- Password -->
            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <PasswordBox Name="txtPassword"
                         Height="36"
                         Padding="8,6"
                         FontSize="14"
                         Margin="0,0,0,10"/>

            <!-- Remember me + Forgot password row -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <CheckBox Content="Remember me" VerticalAlignment="Center"/>
                <TextBlock Text="Forgot password?"
                           Foreground="#2B579A"
                           TextDecorations="Underline"
                           Margin="40,0,0,0"
                           VerticalAlignment="Center"
                           Cursor="Hand"/>
            </StackPanel>

            <!-- Login button -->
            <Button Content="Sign In"
                    Height="40"
                    FontSize="15"
                    FontWeight="Bold"
                    Background="#2B579A"
                    Foreground="White"
                    Margin="0,0,0,16"
                    Click="SignIn_Click"/>

            <!-- Divider -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Rectangle Width="80" Height="1" Fill="#CCCCCC" VerticalAlignment="Center"/>
                <TextBlock Text="  or  " Foreground="#AAAAAA" VerticalAlignment="Center"/>
                <Rectangle Width="80" Height="1" Fill="#CCCCCC" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Register link -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Don't have an account? " Foreground="#555555"/>
                <TextBlock Text="Register"
                           Foreground="#2B579A"
                           FontWeight="Bold"
                           TextDecorations="Underline"
                           Cursor="Hand"/>
            </StackPanel>

        </StackPanel>
    </Border>

</Window>
