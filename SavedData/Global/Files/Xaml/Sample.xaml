<Window xmlns:nos="http://nos.dev/datacontext" x:Class="Gorp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gorp Equation Builder"
        Height="600"
        Width="800"
        Background="#1E1E1E">
  <nos:DataContext nos:mode="json">
    <nos:Json><![CDATA[{
  "Title": "Hello World"
}]]></nos:Json>
    <nos:Gorp><![CDATA[<gorp>
  <models>
    <model namespace="data">
      <variables>
        <variable name="Title" type="string">Hello World</variable>
        <variable name="Count" type="int">42</variable>
      </variables>
    </model>
  </models>
</gorp>]]></nos:Gorp>
  </nos:DataContext>
  
  
  
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Canvas Name="GorpCanvas" Background="#1E1E1E" Width="2000" Height="2000">
            <Border Canvas.Left="50" Canvas.Top="50" Background="#33404D" BorderBrush="#6699CC" BorderThickness="2" CornerRadius="4" Padding="10">
                <StackPanel>
                    <TextBlock Text="GETTING STARTED" Foreground="#CCEAFF" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Drag Gorp math blocks here to build an algorithm." Foreground="#AAAAAA" FontSize="11"/>
                </StackPanel>
            </Border>
        </Canvas>
    </ScrollViewer>
</Window>
