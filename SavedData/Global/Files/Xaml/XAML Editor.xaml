<?xml version="1.0" encoding="utf-16"?>
<Window xmlns:nos="http://nos.dev/datacontext" x:Class="CanvasDemo.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Canvas Layout Demo" Height="500" Width="700">
  <nos:DataContext nos:mode="gorp">
    <nos:Json><![CDATA[{
  "Title": "Receipt",
  "First": "Nick",
  "Last": "Schacter",
  "price": 9.99,
  "qty": 3
}]]></nos:Json>
    <nos:Gorp><![CDATA[<?xml version="1.0" encoding="utf-8" ?>
<gorp>
  <algorithms>
    <algorithm namespace="Simple.JailBreak">
      <input model="orp"/>
      <output model="escape"/>
      <function>
        <expressions>
          <expression sequence="0">
            <Less input="orp" result="escape.result">
              <parameters>
                <parameter position="0">
                  <pathvariable type="int" namespace="orp.timbucktu.sunrise"/>
                </parameter>
                <parameter position ="1">
                  <variable type="int" namespace="orp.limitofcheese" isconstant="true"/>
                </parameter>
              </parameters>
            </Less>
          </expression>
        </expressions>
      </function>
    </algorithm>
    <algorithm namespace="Simple">
      <input model="orp"/>
      <output model="escape"/>
      <function>
        <expressions>
          <expression sequence="0">
            <Algorithm namespace="Simple.JailBreak" input="orp" output="escape" />
          </expression>
        </expressions>
      </function>
    </algorithm>
  </algorithms>
  <models>
    <model namespace="orp">
      <variables>
        <variable name="limitofcheese" type="int" isimmutable="true">500</variable>
        <variable name="harvey" type="int">17</variable>
        <variable name="irrelevant" type="string">"More Than Five"</variable>
      </variables>
      <pathvariables>
        <pathvariable path="timbucktu" name="sunrise" type="int">89</pathvariable>
        <pathvariable path="timbucktu" name="sunset" type="int">-22</pathvariable>
        <pathvariable path="timbucktu" name="tanzania" type="key">9</pathvariable>
      </pathvariables>
      <arrays>
        <array path="local" name="hillgiant" type="[int]">11, 17, 4</array>
      </arrays>
    </model>
    <model namespace="escape">
      <variables>
        <variable name="result" type="bool">false</variable>
      </variables>
    </model>
  </models>
</gorp>
]]></nos:Gorp>
    <nos:Computed>
      <nos:Expr name="Full"><![CDATA[[First] + ' ' + [Last]]]></nos:Expr>
      <nos:Expr name="Total"><![CDATA[[price] * [qty]]]></nos:Expr>
      <nos:Expr name="Receipt"><![CDATA[[qty] + ' items for ' + [price]]]></nos:Expr>
      <nos:Expr name="All"><![CDATA[[Full] + ' purchased ' + [Receipt] + ' = ' + [Total]]]></nos:Expr>
    </nos:Computed>
  </nos:DataContext>
    <!-- Demonstrates: Canvas with absolute positioning, Rectangle, Ellipse,
         TextBlock, Border, Button — the core Phase 2 rendering targets -->
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="Blue" />
        <SolidColorBrush x:Key="MyBrush" Color="Red" />
    </Window.Resources>
    <Canvas Background="#F0F0F0">
        <!-- Background rectangle -->
        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="700" Height="80" Fill="#2B579A" />
        <!-- Header text -->
        <TextBlock Canvas.Left="20" Canvas.Top="24" Text="Canvas Layout Demo" Foreground="White" FontSize="24" FontWeight="Bold" />
        <!-- Card 1 -->
        <Border Canvas.Left="240" Canvas.Top="110" Width="200" Height="120" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6">
            <StackPanel Margin="12">
                <TextBlock Text="{Binding harvey}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                <TextBlock Text="{Binding Path=irrelevant}" TextWrapping="Wrap" Foreground="#555555" />
            </StackPanel>
            <StackPanel Margin="12">
                <TextBlock Text="{Binding result}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                <TextBlock Text="{Binding timbucktu.sunrise}" TextWrapping="Wrap" Foreground="#555555" />
            </StackPanel>
        </Border>
        <Border Canvas.Left="20" Canvas.Top="110" Width="195" Height="145" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6">
            <StackPanel Margin="12" Width="175" Height="40">
                <TextBlock Text="{Binding Path=Full}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" Canvas.Left="27" Canvas.Top="83" Width="120" Height="25" />
                <TextBlock Text="{Binding Path=Receipt}" TextWrapping="Wrap" Foreground="#555555" Width="214" Height="28" />
                <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,6" Text="{Binding Path=Total, Mode=OneWay}" Width="188" Height="25" Total="[Price] * [Qty]" />
                <TextBlock FontWeight="Bold" FontSize="6" Margin="0,0,0,6" Text="{Binding Path=All}" Width="182" Height="31" Receipt="[First] + [Total]" />
            </StackPanel>
        </Border>
        <!-- Card 2 -->
        <!-- Card 3 -->
        <Border Canvas.Left="460" Canvas.Top="110" Width="200" Height="120" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6"></Border>
        <!-- Shapes section label -->
        <TextBlock Canvas.Left="20" Canvas.Top="260" Text="Shapes:" FontWeight="Bold" FontSize="14" Foreground="#333333" />
        <!-- Shapes row -->
        <Rectangle Canvas.Left="20" Canvas.Top="285" Width="80" Height="60" Fill="#2B579A" RadiusX="4" RadiusY="4" />
        <Rectangle Canvas.Left="120" Canvas.Top="285" Width="80" Height="60" Fill="#27AE60" RadiusX="4" RadiusY="4" />
        <Ellipse Canvas.Left="220" Canvas.Top="285" Width="80" Height="60" Fill="#E74C3C" />
        <Ellipse Canvas.Left="320" Canvas.Top="285" Width="60" Height="60" Fill="#F39C12" />
        <!-- Button row -->
        <Button Canvas.Left="20" Canvas.Top="380" Content="Cancel" Width="100" Height="32" />
        <Button Canvas.Left="132" Canvas.Top="380" Content="Save" Width="100" Height="32" Background="#27AE60" Foreground="White" />
        <Button Canvas.Left="244" Canvas.Top="380" Content="Submit" Width="100" Height="32" Background="#2B579A" Foreground="White" />
        <!-- Overlapping z-order demo -->
        <Ellipse Canvas.Left="580" Canvas.Top="280" Width="100" Height="100" Fill="#3498DB" Opacity="0.8" />
        <Ellipse Canvas.Left="610" Canvas.Top="310" Width="100" Height="100" Fill="#9B59B6" Opacity="0.8" />
        <TextBlock Canvas.Left="585" Canvas.Top="410" Text="Z-order overlap" Foreground="#333333" FontSize="11" />
    </Canvas>
</Window>