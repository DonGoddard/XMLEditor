<?xml version="1.0" encoding="utf-8" ?>
<UMLDiagram name="Test"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:proto="http://www.seraphimtechnology.ai/ns/protoclass"
    xmlns:data="http://www.seraphimtechnology.ai/ns/properties"
    xmlns:code="http://www.seraphimtechnology.ai/ns/methods"
    xmlns:sym="http://www.seraphimtechnology.ai/ns/symbols"
    xmlns:index="http://www.seraphimtechnology.ai/ns/indexes"
    xmlns:gestalt="http://www.seraphimtechnology.ai/ns/gestalt"
    xmlns:cloud="http://www.seraphimtechnology.ai/ns/cloud"
    xmlns:gns="http://www.seraphimtechnology.ai/ns/gestalt-name-service"
    xmlns:sera="http://www.seraphimtechnology.ai/ns/seraphimai"
    xmlns:uaiml="http://www.seraphimnexus.ai/ns/uaiml"
    xmlns:gorp="http://www.seraphimtechnology.ai/ns/gorp"
    xmlns:nos="http://nos.local/uml-layout">

  <proto:Class x:Name="User" nos:x="24" nos:y="56" nos:width="240" nos:height="180">
    <proto:DisplayName>Fred</proto:DisplayName>
    <data:Property visibility="public"    x:Name="email"        type="x:String"/>
    <data:Property visibility="protected" x:Name="passwordHash" type="x:String"/>
    <code:Method   visibility="public"    x:Name="Login"        return="x:Boolean"/>
    <code:Method   visibility="public"    x:Name="Logout"       return="x:Void"/>
    <proto:Inherits target="Admin"/>
  </proto:Class>

  <proto:Class x:Name="Admin" nos:x="438" nos:y="24" nos:width="240" nos:height="140">
    <data:Property visibility="public" x:Name="permissions" type="x:String"/>
    <code:Method   visibility="public" x:Name="BanUser"     return="x:Void"/>
  </proto:Class>

  <proto:Class x:Name="Product" nos:x="537" nos:y="230" nos:width="240" nos:height="140">
    <data:Property visibility="public" x:Name="sku"   type="x:String"/>
    <data:Property visibility="public" x:Name="price" type="x:Double"/>
    <code:Method   visibility="public" x:Name="UpdateStock" return="x:Void"/>
  </proto:Class>

  <proto:Class x:Name="Order" nos:x="174" nos:y="427" nos:width="240" nos:height="120">
    <data:Property visibility="public" x:Name="orderId" type="x:Int32"/>
    <code:Method   visibility="public" x:Name="Process" return="x:Boolean"/>
  </proto:Class>

  <proto:Relationship from="User"  to="Order"   kind="Association"/>
  <proto:Relationship from="Order" to="Product" kind="Aggregation" sourceMulti="1" targetMulti="0..1" label="contains"/>

  <!-- Unknown sibling content; preserved untouched by the parser. -->
  <sym:Symbol id="orderflow-marker"/>
</UMLDiagram>
