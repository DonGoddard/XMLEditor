<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UmlWindow Verification" Width="1180" Height="760" x:Name="VerificationWindow" Background="#1F232A"><Window.Resources><SolidColorBrush x:Key="AccentBrush" Color="#4EC9B0" /><Style x:Key="PrimaryButtonStyle" TargetType="Button"><Setter Property="Background" Value="#2D6A4F" /><Setter Property="Foreground" Value="White" /><Setter Property="Padding" Value="12,6" /></Style></Window.Resources><Grid x:Name="RootGrid" Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions><Border x:Name="HeaderCard" Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12" Padding="16" CornerRadius="10" Background="#2B2F36" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"><DockPanel LastChildFill="False"><TextBlock x:Name="HeaderTitle" DockPanel.Dock="Left" FontSize="24" FontWeight="Bold" Foreground="White" Text="UML Window XAML Verification" /><StackPanel x:Name="HeaderActions" DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="RefreshButton" Margin="0,0,8,0" Content="Refresh" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}" /><Button x:Name="ExportButton" Content="Export" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExportCommand}" /></StackPanel></DockPanel></Border><StackPanel x:Name="NavigationPanel" Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" Background="#252932"><TextBlock x:Name="NavTitle" Margin="12,12,12,6" FontSize="18" Foreground="#DCDCDC" Text="Navigation" /><ListBox x:Name="NavList" Margin="12,0,12,12" SelectedItem="{Binding SelectedNavItem}"><ListBoxItem Content="Overview" /><ListBoxItem Content="Orders" /><ListBoxItem Content="Products" /><ListBoxItem Content="Customers" /></ListBox></StackPanel><Grid x:Name="ContentGrid" Grid.Row="1" Grid.Column="1" Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><WrapPanel x:Name="SummaryWrap" Grid.Row="0" Margin="0,0,0,12"><Border x:Name="SummaryRevenue" Width="180" Margin="0,0,12,12" Padding="12" Background="#2B2F36"><StackPanel><TextBlock Foreground="#9AA0A6" Text="Revenue" /><TextBlock FontSize="20" Foreground="White" Text="{Binding RevenueDisplay}" /></StackPanel></Border><Border x:Name="SummaryOrders" Width="180" Margin="0,0,12,12" Padding="12" Background="#2B2F36"><StackPanel><TextBlock Foreground="#9AA0A6" Text="Orders" /><TextBlock FontSize="20" Foreground="White" Text="{Binding OrderCount}" /></StackPanel></Border><Border x:Name="SummaryUsers" Width="180" Margin="0,0,12,12" Padding="12" Background="#2B2F36"><StackPanel><TextBlock Foreground="#9AA0A6" Text="Active Users" /><TextBlock FontSize="20" Foreground="White" Text="{Binding ActiveUsers}" /></StackPanel></Border></WrapPanel><ScrollViewer x:Name="DataScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DataStack"><GroupBox x:Name="CustomerGroup" Margin="0,0,0,12" Header="Customer"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,8" Foreground="#DCDCDC" Text="Name" /><TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Customer.Name}" /><TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,8" Foreground="#DCDCDC" Text="Email" /><TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Customer.Email}" /><CheckBox x:Name="IsVipCheck" Grid.Row="2" Grid.Column="1" Content="VIP customer" IsChecked="{Binding Customer.IsVip}" /></Grid></GroupBox><GroupBox x:Name="CanvasGroup" Header="Canvas Test"><Canvas x:Name="FreeformCanvas" Height="220" Background="#20242A"><Rectangle x:Name="CanvasCard" Canvas.Left="24" Canvas.Top="22" Width="180" Height="88" Fill="#355C7D" /><TextBlock x:Name="CanvasLabel" Canvas.Left="38" Canvas.Top="42" Foreground="White" Text="Absolute Canvas Positioning" /><Button x:Name="CanvasAction" Canvas.Left="242" Canvas.Top="34" Width="140" Content="Canvas Action" Command="{Binding CanvasActionCommand}" /><Ellipse x:Name="CanvasPulse" Canvas.Left="420" Canvas.Top="28" Width="54" Height="54" Fill="{StaticResource AccentBrush}" /></Canvas></GroupBox></StackPanel></ScrollViewer></Grid><Border x:Name="InspectorPanel" Grid.Row="1" Grid.Column="2" Background="#252932" Padding="16"><StackPanel><TextBlock x:Name="InspectorTitle" FontSize="18" Foreground="#DCDCDC" Text="Inspector" /><TextBlock x:Name="InspectorStatus" Margin="0,12,0,6" Foreground="#9AA0A6" Text="Status" /><ComboBox x:Name="StatusCombo" SelectedItem="{Binding SelectedStatus}"><ComboBoxItem Content="Draft" /><ComboBoxItem Content="Pending" /><ComboBoxItem Content="Active" /><ComboBoxItem Content="Archived" /></ComboBox><Slider x:Name="PrioritySlider" Margin="0,16,0,0" Minimum="0" Maximum="100" Value="{Binding PriorityValue}" /><TextBlock x:Name="PriorityValueText" Margin="0,6,0,0" Foreground="#DCDCDC" Text="{Binding PriorityLabel}" /></StackPanel></Border><DockPanel x:Name="FooterPanel" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0"><TextBlock x:Name="FooterHint" DockPanel.Dock="Left" Foreground="#80868B" Text="Footer contains text, bindings, and simple layout relationships." /><Label x:Name="FooterVersion" DockPanel.Dock="Right" Foreground="#80868B" Content="{Binding VersionLabel}" /></DockPanel></Grid></Window>