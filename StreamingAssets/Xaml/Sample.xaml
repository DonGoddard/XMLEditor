<Window x:Class="KitchenSink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kitchen Sink Sample" Height="600" Width="800">

    <!-- Demonstrates: Window, StackPanel, Border, TextBlock, Button, TextBox,
         CheckBox, RadioButton, Slider, ComboBox, WrapPanel, ScrollViewer -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Orientation="Vertical">

            <!-- Header -->
            <Border Background="#2B579A" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <TextBlock Text="WPF Kitchen Sink Sample"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Text controls -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Text Controls" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <TextBlock Text="This is a regular TextBlock for read-only display." Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <TextBox Text="Editable TextBox" Margin="0,0,0,6" Padding="4"/>
                    <TextBox Text="Multi-line TextBox&#x0a;Second line here" AcceptsReturn="True" Height="60" Padding="4" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Buttons" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Content="Default Button" Margin="0,0,8,8" Padding="10,4"/>
                        <Button Content="Primary" Background="#2B579A" Foreground="White" Margin="0,0,8,8" Padding="10,4"/>
                        <Button Content="Danger" Background="#C0392B" Foreground="White" Margin="0,0,8,8" Padding="10,4"/>
                        <Button Content="Disabled" IsEnabled="False" Margin="0,0,8,8" Padding="10,4"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Checkboxes and Radios -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Selection Controls" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <CheckBox Content="Unchecked option" Margin="0,0,0,4"/>
                    <CheckBox Content="Checked option" IsChecked="True" Margin="0,0,0,4"/>
                    <CheckBox Content="Indeterminate option" IsChecked="{x:Null}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Option A" GroupName="Demo" IsChecked="True" Margin="0,0,12,0"/>
                        <RadioButton Content="Option B" GroupName="Demo" Margin="0,0,12,0"/>
                        <RadioButton Content="Option C" GroupName="Demo"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ComboBox and Slider -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Value Controls" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <TextBlock Text="ComboBox:" Margin="0,0,0,4"/>
                    <ComboBox SelectedIndex="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <ComboBoxItem>First Item</ComboBoxItem>
                        <ComboBoxItem>Second Item</ComboBoxItem>
                        <ComboBoxItem>Third Item</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Slider (0–100):" Margin="0,0,0,4"/>
                    <Slider Minimum="0" Maximum="100" Value="35" Width="300" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Shapes and colors -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Shapes" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Rectangle Width="60" Height="40" Fill="#2B579A" Margin="0,0,8,0"/>
                        <Rectangle Width="60" Height="40" Fill="#27AE60" Margin="0,0,8,0"/>
                        <Ellipse Width="60" Height="40" Fill="#E74C3C" Margin="0,0,8,0"/>
                        <Ellipse Width="40" Height="40" Fill="#F39C12" Margin="0,0,8,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</Window>
