<?xml version="1.0" encoding="utf-8"?>
<!--
  AI Designer starter document — the first-run sample.

  Root is <gorp> because that is what UmlWindow.Parse.cs dispatches to
  ParseGorp, the parser that understands <data>, <model> and <algorithm>.

  Members MUST sit inside a <variables> container — ParseModelMembersInto
  selects `*[local-name()='variables']/*[local-name()='variable']`, so a
  <variable> placed directly under <data> parses to nothing and the node
  renders as an empty box. Same for <operations>/<operation>.

  HOW THE THREE CONSTRUCTS TIE TOGETHER (Scripts/Plans/ModelWiringPlan-2026-09-09.md):

    «model»      a SHAPE. The algorithm's Input and Output ports name models.
    «data»       an INSTANCE of a model: of="…" names the shape, the rows carry
                 values. On Run the values are sent as <inputs>, keyed
                 Model.field. A data node with no of= is its own model.
    «algorithm»  reads ONE input model and writes ONE output model (SAI's
                 limit). Needs two? Compose them: a model whose fields
                 reference each source with of="…" — ScoreInput below.
    of="X"       on a FIELD: this field refers to an instance of X. Drawn as an
                 arrow from the row. On a DATA node: the model it instantiates.

  NOTE: every Editor save rewrites this file — UmlWindow.File.cs writes the
  document back to `resourceFileName` under UNITY_EDITOR as a local seed. If
  it has turned into someone's working diagram, restore it from here. See
  item 7 in Scripts/Plans/AiDesignerPlan-2026-08-21.md.
-->
<gorp name="Churn Example">

  <!-- «model» — the shape of a customer record. -->
  <model namespace="ai.sample.CustomerRecords">
    <variables>
      <variable name="id"       type="key" />
      <variable name="tenure"   type="int"    collapse="Monotone"><unit basis="\one" namespace="D-SI"/></variable>
      <variable name="monthly"  type="double" collapse="Monotone"><unit basis="\one" namespace="D-SI"/></variable>
      <variable name="churned"  type="bool" />
      <variable name="signedUp" type="utcdatetime" />
    </variables>
  </model>

  <!-- «model» — the shape learned over that data, not the rows themselves. -->
  <model namespace="ai.sample.ChurnPredictor">
    <variables>
      <variable name="features"  type="[double]" />
      <variable name="weights"   type="[double]" />
      <variable name="bias"      type="double = 0.0" />
      <variable name="threshold" type="double = 0.5" />
      <variable name="labels"    type="[symbol]" />
    </variables>
    <operations>
      <operation name="predict" returns="double" />
    </operations>
  </model>

  <!-- «model» — SAI allows one input per algorithm, so an algorithm that needs
       both the records and the predictor reads a COMPOSED model: one field per
       source, each an of="…" reference. The canvas draws each field's arrow. -->
  <model namespace="ai.sample.ScoreInput">
    <variables>
      <variable name="records"   type="key" of="ai.sample.CustomerRecords" />
      <variable name="predictor" type="key" of="ai.sample.ChurnPredictor" />
    </variables>
  </model>

  <!-- «model» — what the algorithm produces. The Gorp samples' `escape`. -->
  <model namespace="ai.sample.Verdict">
    <variables>
      <variable name="result" type="bool">false</variable>
      <variable name="score"  type="double" collapse="Monotone"><unit basis="\one" namespace="D-SI"/></variable>
    </variables>
  </model>

  <!-- «data» — one customer, as an INSTANCE of CustomerRecords. The rows are
       values; on Run they become <inputs> keyed ai.sample.CustomerRecords.id … -->
  <data namespace="ai.sample.CustomerRows" of="ai.sample.CustomerRecords">
    <variables>
      <variable name="id"      type="key">C-1042</variable>
      <variable name="tenure"  type="int"    collapse="Monotone">14<unit basis="\one" namespace="D-SI"/></variable>
      <variable name="monthly" type="double" collapse="Monotone">42.50<unit basis="\one" namespace="D-SI"/></variable>
      <variable name="churned" type="bool">false</variable>
    </variables>
  </data>

  <!-- «data» — a log with no model of its own (it IS its shape), whose
       `customer` field REFERS to a CustomerRecords instance. -->
  <data namespace="ai.sample.TransactionLog">
    <variables>
      <variable name="id"       type="guid" />
      <variable name="customer" type="key" of="ai.sample.CustomerRecords.id" />
      <variable name="amounts"  type="[double]" />
      <variable name="source"   type="uri" />
    </variables>
  </data>

  <!-- «algorithm» — the runnable step xmlIT executes.

       <input>/<output> are the PORTS on the canvas — one model each.

       <function><expressions> is the algorithm's FLOW in Gorp's own idiom
       (Gorp.Loop.xml is the canonical case): numbered steps run in order,
       <If> guards a <goto sequence>, and falling off the last step ends. The
       State Machine view reads exactly this — one state per sequence, one
       transition per goto or fall-through. `name` on an <expression> is our
       display label; Gorp ignores it. Steps reach into models by DOTTED PATH
       (<ci>ai.sample.CustomerRecords.monthly</ci>) — through the composed
       input's references — and write results the same way
       (output="ai.sample.Verdict.result"). Check verifies every path. -->
  <!-- «algorithm» — the step ScoreAndRank's <Algorithm> element calls (Rank,
       its `delegate=` target, is declared at the end of the file). Declared so
       every name the flow uses is a construct of this design: the no-fail
       rule (2026-09-10) greys a design that calls what it does not have. -->
  <algorithm namespace="ai.sample.Explain">
    <input  model="ai.sample.CustomerRecords" />
    <output model="ai.sample.Verdict" />
    <operations>
      <operation name="explain" returns="string" />
    </operations>
  </algorithm>

  <algorithm namespace="ai.sample.ScoreAndRank">
    <input  model="ai.sample.ScoreInput" />
    <output model="ai.sample.Verdict" />
    <operations>
      <operation name="score"   returns="double" />
      <operation name="rank"    returns="[key]" />
      <operation name="explain" returns="string" />
    </operations>
    <function>
      <expressions>
        <expression sequence="0" name="score">
          <Math>
            <math xmlns="http://www.w3.org/1998/Math/MathML">
              <apply>
                <plus/>
                <ci>ai.sample.ChurnPredictor.bias</ci>
                <ci>ai.sample.CustomerRecords.monthly</ci>
              </apply>
            </math>
          </Math>
        </expression>
        <expression sequence="1" name="low spender?">
          <If input="ai.sample.CustomerRecords">
            <parameters>
              <parameter position="0">
                <Less input="ai.sample.CustomerRecords" output="ai.sample.Verdict.result">
                  <parameters>
                    <parameter position="0">
                      <pathvariable type="double" namespace="ai.sample.CustomerRecords.monthly"/>
                    </parameter>
                    <parameter position="1">20</parameter>
                  </parameters>
                </Less>
              </parameter>
              <parameter position="1">
                <goto sequence="3"/>
              </parameter>
            </parameters>
          </If>
        </expression>
        <expression sequence="2" name="rank" delegate="ai.sample.Rank" limit="1"/>
        <expression sequence="3" name="explain">
          <Algorithm namespace="ai.sample.Explain" input="ai.sample.CustomerRecords" output="ai.sample.Verdict"/>
        </expression>
        <expression sequence="4" name="more customers?">
          <If input="ai.sample.CustomerRecords">
            <parameters>
              <parameter position="0">
                <Greater input="ai.sample.CustomerRecords">
                  <parameters>
                    <parameter position="0">
                      <pathvariable type="int" namespace="ai.sample.CustomerRecords.tenure"/>
                    </parameter>
                    <parameter position="1">0</parameter>
                  </parameters>
                </Greater>
              </parameter>
              <parameter position="1">
                <goto sequence="0"/>
              </parameter>
            </parameters>
          </If>
        </expression>
      </expressions>
    </function>
  </algorithm>

  <!-- «algorithm» — a step of ScoreAndRank delegates here, so a dashed
       «delegate» arrow is DERIVED from that step. Nothing to draw. -->
  <algorithm namespace="ai.sample.Rank">
    <input  model="ai.sample.ScoreInput" />
    <output model="ai.sample.Verdict" />
    <operations>
      <operation name="rank" returns="[key]" />
    </operations>
  </algorithm>

</gorp>
